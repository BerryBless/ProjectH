<Project Sdk="Microsoft.NET.Sdk">

  <!-- QA Scenario Orchestrator (Docs/specs/2026-10-02-qa-tool-design.md D1). A client like the bots: it talks to the
       server only through the game protocol (ProjectH.Bots) and the QA Control HTTP API, never ProjectH.Server. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>ProjectH.QA</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ProjectH.QA.Tests" />
  </ItemGroup>

  <!-- QA-2 D19: the web UI (Kestrel + Minimal API) from the shared framework, not a NuGet package. The static files are
       plain HTML/CSS/JS copied next to the binaries (no npm, no bundler). -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <None Include="wwwroot\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ProjectH.Bots\ProjectH.Bots.csproj" />
    <ProjectReference Include="..\ProjectH.Shared\ProjectH.Shared.csproj" />
  </ItemGroup>

</Project>
