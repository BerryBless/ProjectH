<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\ProjectH.Bots\ProjectH.Bots.csproj" />
    <ProjectReference Include="..\..\src\ProjectH.Server\ProjectH.Server.csproj" />
    <ProjectReference Include="..\..\src\ProjectH.Shared\ProjectH.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Phase 5: the client's display copy of the zone formula, compiled here only so ZoneMathParityTests can
         compare it with the server's SafeZone on the same inputs. Pure C# (no UnityEngine); the server itself
         never references client code. -->
    <Compile Include="..\..\..\Client\Assets\Scripts\Game\ZoneMath.cs" Link="ClientCopies\ZoneMath.cs" />
    <!-- Phase 11 D3, D10, D11: the client's screen flow, UI strings and kill feed ring, tested here the same way (pure C#,
         no UnityEngine). UiText uses LiteNetLib's DisconnectReason, which this project gets through the server. -->
    <Compile Include="..\..\..\Client\Assets\Scripts\UI\UiFlow.cs" Link="ClientCopies\UI\UiFlow.cs" />
    <Compile Include="..\..\..\Client\Assets\Scripts\UI\UiText.cs" Link="ClientCopies\UI\UiText.cs" />
    <Compile Include="..\..\..\Client\Assets\Scripts\UI\KillFeedModel.cs" Link="ClientCopies\UI\KillFeedModel.cs" />
    <!-- Phase 12 D9: the client's copy of the door rule, compared with the server's DoorRules (DoorTests). -->
    <Compile Include="..\..\..\Client\Assets\Scripts\Game\DoorRule.cs" Link="ClientCopies\DoorRule.cs" />
    <!-- Phase 14: the client's display copies of the squad.json defaults (SquadCatalogTests compares them). -->
    <Compile Include="..\..\..\Client\Assets\Scripts\Game\SquadPrompt.cs" Link="ClientCopies\SquadPrompt.cs" />
    <!-- Phase 12 final review: the client's predicted door world, compared with the server's DoorSet (DoorTests). -->
    <Compile Include="..\..\..\Client\Assets\Scripts\Game\PredictedDoors.cs" Link="ClientCopies\PredictedDoors.cs" />
    <!-- Phase 13 D5: the client's copy of the tool rule, compared with the server's HarvestRules.SelectTool (ToolTests). -->
    <Compile Include="..\..\..\Client\Assets\Scripts\Game\Build\ToolState.cs" Link="ClientCopies\ToolState.cs" />
    <!-- Phase 13 D13, D14: the client's build store, fed the server's real building stream (BuildReplicationTests). -->
    <Compile Include="..\..\..\Client\Assets\Scripts\Game\Build\BuildStore.cs" Link="ClientCopies\BuildStore.cs" />
    <!-- Phase 16 D4: the client's copy of the container rule, compared with the server's ContainerRules (ContainerRulesTests). -->
    <Compile Include="..\..\..\Client\Assets\Scripts\Game\ContainerRule.cs" Link="ClientCopies\ContainerRule.cs" />
    <!-- Phase 19 D6, D15: the client's copy of the vehicle enter rule and maxHealth, compared with the server's (VehicleMatchTests). -->
    <Compile Include="..\..\..\Client\Assets\Scripts\Game\VehiclePrompt.cs" Link="ClientCopies\VehiclePrompt.cs" />
    <!-- Review fix A3 (A-T7): the client's connection (cookie retry), compiled here so the slnx build checks it against
         Shared v19 (pure C#: LiteNetLib comes through the server reference, no UnityEngine). -->
    <Compile Include="..\..\..\Client\Assets\Scripts\Net\NetClient.cs" Link="ClientCopies\Net\NetClient.cs" />
    <!-- Review fix B3 (B-T5): the client's authentication layer that NetClient uses. -->
    <Compile Include="..\..\..\Client\Assets\Scripts\Net\AuthPacketLayer.cs" Link="ClientCopies\Net\AuthPacketLayer.cs" />
    <!-- Review fix C2: the client's copy of the weapon rules (equip wait), compared with the server's WeaponRules
         (ClientWeaponStateParityTests). -->
    <Compile Include="..\..\..\Client\Assets\Scripts\Game\WeaponState.cs" Link="ClientCopies\Game\WeaponState.cs" />
    <!-- Review fix D3: the client's server clock (tick window), pure C#, compiled here so the slnx build checks it. Its EditMode
         tests (ServerClockTests.cs) are NUnit, which this xUnit project does not reference, so they run in Unity only. -->
    <Compile Include="..\..\..\Client\Assets\Scripts\Game\ServerClock.cs" Link="ClientCopies\Game\ServerClock.cs" />
  </ItemGroup>

</Project>