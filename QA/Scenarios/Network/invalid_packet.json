{
  "schemaVersion": 1,
  "name": "Invalid Packets",
  "description": "Request §127 (D14): invalid packets over a live connection. The server counts each one (badPackets) and keeps the sender connected below Server:BadPacketDisconnectThreshold (20); at the threshold it kicks only that peer (DisconnectCode.Kicked). An input flood above the per-peer rate (SimHz x 2 per second) is rejected the same way. The server keeps running and the other players are unaffected.",
  "tags": ["network", "faults", "security"],
  "seed": 1271,
  "timeoutSeconds": 60,
  "server": { "mode": "launch", "options": { "Server:MinPlayers": "2" } },
  "actors": [ { "id": "playerA" }, { "id": "playerB" }, { "id": "playerC" } ],
  "steps": [
    { "id": "a_connect", "action": "connect", "actor": "playerA" },
    { "id": "b_connect", "action": "connect", "actor": "playerB" },
    { "id": "c_connect", "action": "connect", "actor": "playerC" },
    { "id": "match_playing", "action": "waitFor", "condition": "match.state", "equals": "Playing", "timeoutMilliseconds": 15000 },
    { "id": "bad_before", "action": "save", "path": "server.metrics.health.badPackets", "saveAs": "badBefore" },
    { "id": "bad_zero", "assert": "var.badBefore", "equals": 0 },

    { "id": "a_some_bad", "phase": "act", "action": "sendInvalidPackets", "actor": "playerA", "kinds": ["unknownId", "truncated", "oversized"], "count": 3, "description": "9 invalid packets: below the kick threshold" },
    { "id": "bad_counted", "phase": "assert", "action": "waitFor", "condition": "server.metrics.health.badPackets", "equals": 9, "timeoutMilliseconds": 5000 },
    { "id": "a_kept", "action": "wait", "milliseconds": 500 },
    { "id": "a_still_connected", "assert": "network.connected", "actor": "playerA", "equals": true },
    { "id": "a_server_connected", "assert": "player.connected", "actor": "playerA", "equals": true },

    { "id": "a_garbage", "phase": "act", "action": "sendInvalidPackets", "actor": "playerA", "kinds": ["garbage"], "count": 15, "description": "15 more: 24 in total, over the threshold 20" },
    { "id": "a_kicked", "phase": "assert", "action": "waitFor", "condition": "network.disconnectCode", "actor": "playerA", "equals": "Kicked", "timeoutMilliseconds": 5000 },
    { "id": "bad_total", "action": "waitFor", "condition": "server.metrics.health.badPackets", "greaterThan": 19, "timeoutMilliseconds": 3000 },

    { "id": "c_flood", "phase": "act", "action": "sendInvalidPackets", "actor": "playerC", "kinds": ["inputFlood"], "count": 120, "description": "120 inputs in one tick: far above the input rate" },
    { "id": "c_kicked", "phase": "assert", "action": "waitFor", "condition": "network.disconnectCode", "actor": "playerC", "equals": "Kicked", "timeoutMilliseconds": 5000 },

    { "id": "server_running", "assert": "server.running", "equals": true },
    { "id": "no_tick_failures", "assert": "server.metrics.health.tickFailures", "equals": 0 },
    { "id": "b_connected", "assert": "player.connected", "actor": "playerB", "equals": true },
    { "id": "b_packets", "action": "save", "path": "network.packetsIn", "actor": "playerB", "saveAs": "bPackets" },
    { "id": "b_still_receiving", "action": "waitFor", "condition": "network.packetsIn", "actor": "playerB", "greaterThan": "${bPackets}", "timeoutMilliseconds": 2000 },
    { "id": "b_network_ok", "assert": "network.connected", "actor": "playerB", "equals": true }
  ]
}
