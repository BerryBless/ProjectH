{
  "schemaVersion": 1,
  "name": "Movement MoveTo",
  "description": "Request §117: a client walks 20 m with real movement inputs (the server simulates every step) and the server's position ends at the target.",
  "tags": ["movement", "smoke"],
  "seed": 2001,
  "timeoutSeconds": 60,
  "actors": [ { "id": "playerA" } ],
  "steps": [
    { "id": "a_connect", "action": "connect", "actor": "playerA" },
    { "id": "a_start", "phase": "arrange", "action": "setPosition", "actor": "playerA", "position": "QA_Move_Start" },
    { "id": "a_settled", "action": "waitFor", "condition": "actor.position.x", "actor": "playerA", "approximately": -10, "tolerance": 0.5, "timeoutMilliseconds": 3000 },
    { "id": "a_walk", "phase": "act", "action": "moveTo", "actor": "playerA", "position": "QA_Move_End", "tolerance": 0.75 },
    { "id": "a_at_x", "phase": "assert", "action": "waitFor", "condition": "player.position.x", "actor": "playerA", "approximately": 10, "tolerance": 1.5, "timeoutMilliseconds": 2000 },
    { "id": "a_at_z", "assert": "player.position.z", "actor": "playerA", "approximately": 6, "tolerance": 1.5 },
    { "id": "a_grounded", "assert": "player.grounded", "actor": "playerA", "equals": true },
    { "id": "no_anomaly", "assert": "server.metrics.health.movementAnomalies", "equals": 0 }
  ]
}
