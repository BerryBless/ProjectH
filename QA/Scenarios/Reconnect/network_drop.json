{
  "schemaVersion": 1,
  "name": "Network Drop And Reconnect",
  "description": "Request §74 with a real network loss: A (through its fault proxy) loses its connection without a word (dropConnection: no disconnect packet). The server notices only through its DisconnectTimeoutMs (5 s), graces the living participant, and A comes back within ReconnectGraceSeconds (10 s) through a new proxy (new client port, new upstream endpoint) and resumes the same character.",
  "tags": ["reconnect", "network", "faults"],
  "seed": 7401,
  "timeoutSeconds": 90,
  "server": { "mode": "launch", "options": { "Server:MinPlayers": "2" } },
  "actors": [ { "id": "playerA", "network": { "proxy": true } }, { "id": "playerB" } ],
  "steps": [
    { "id": "a_connect", "action": "connect", "actor": "playerA" },
    { "id": "b_connect", "action": "connect", "actor": "playerB" },
    { "id": "match_playing", "action": "waitFor", "condition": "match.state", "equals": "Playing", "timeoutMilliseconds": 15000 },

    { "id": "a_place", "phase": "arrange", "action": "setPosition", "actor": "playerA", "position": "QA_Spawn_A" },
    { "id": "a_health", "action": "setHealth", "actor": "playerA", "value": 64 },
    { "id": "a_shield", "action": "setShield", "actor": "playerA", "value": 30 },
    { "id": "a_rifle", "action": "giveWeapon", "actor": "playerA", "weapon": "Kestrel LR" },
    { "id": "a_medkit", "action": "giveItem", "actor": "playerA", "item": "medkit", "count": 1 },
    { "id": "a_entity", "action": "save", "path": "player.entityId", "actor": "playerA", "saveAs": "aEntity" },
    { "id": "a_pos", "action": "save", "path": "player.position", "actor": "playerA", "saveAs": "aPos" },

    { "id": "a_drop", "phase": "act", "action": "dropConnection", "actor": "playerA" },
    { "id": "a_still_connected_1s", "phase": "assert", "action": "wait", "milliseconds": 1000 },
    { "id": "server_not_yet", "assert": "player.connected", "actor": "playerA", "equals": true, "description": "no packet told the server: it still counts A as connected" },
    { "id": "a_graced", "action": "waitFor", "condition": "player.graced", "actor": "playerA", "equals": true, "timeoutMilliseconds": 8000, "description": "graced after the server's DisconnectTimeoutMs" },
    { "id": "graced_event", "action": "waitForEvent", "event": "PlayerGraced", "actor": "playerA", "timeoutMilliseconds": 3000 },
    { "id": "a_reconnect", "phase": "act", "action": "reconnect", "actor": "playerA" },

    { "id": "resumed_event", "phase": "assert", "action": "waitForEvent", "event": "PlayerResumed", "actor": "playerA", "timeoutMilliseconds": 3000 },
    { "id": "a_connected", "assert": "player.connected", "actor": "playerA", "equals": true },
    { "id": "a_same_entity", "assert": "player.entityId", "actor": "playerA", "equals": "${aEntity}" },
    { "id": "a_hp", "assert": "player.health", "actor": "playerA", "equals": 64 },
    { "id": "a_sh", "assert": "player.shield", "actor": "playerA", "equals": 30 },
    { "id": "a_weapon", "assert": "player.weapon.name", "actor": "playerA", "equals": "Kestrel LR" },
    { "id": "a_medkits", "assert": "player.medkits", "actor": "playerA", "equals": 1 },
    { "id": "a_same_place", "assert": "player.position.x", "actor": "playerA", "approximately": "${aPos.x}", "tolerance": 0.5 },
    { "id": "a_new_proxy", "assert": "network.proxy.attempts", "actor": "playerA", "equals": 2, "description": "the reconnect went through a new proxy" },
    { "id": "a_client_view", "action": "waitFor", "condition": "actor.entityId", "actor": "playerA", "equals": "${aEntity}", "timeoutMilliseconds": 2000 },
    { "id": "b_unaffected", "assert": "player.connected", "actor": "playerB", "equals": true },
    { "id": "still_playing", "assert": "match.state", "equals": "Playing" }
  ]
}
