{
  "schemaVersion": 1,
  "name": "Stress Building",
  "description": "Request §20-23, §112: real build requests (build mode, aim, BuildRequest after the input that carries the aim) on separate sites: each builder claims its own flat site of the map (BuildSitePool, nearest the centre first) and builds a small structure there: ramps, floors, walls on two levels and a roof (wall/floor/ramp/roof). ${turboPercent}% are turbo builders (${turboRate} requests/s, within the server's 0.1 s interval and 20/s limit), the rest build at ${buildRate}/s; ${moverPercent}% only walk around. Recycling: a finished site is taken down by its builder with real shots at its level-0 pieces (what stands on them collapses through the server's support rules) and built again, so placing, destroying and collapsing keep going for the whole run. Server:BuildInfiniteResources=true because resources are not what this measures and building.json caps resources at 500 (50 wood pieces), less than a 60 s steady phase places; every other placement rule (range, sight, support, occupancy, rate) still applies. The map has about 40 flat sites, so the parameters stop at 50 players (75/100 would make builders share sites). No hard limit (D42).",
  "tags": ["stress", "server", "building", "quick"],
  "stress": true,
  "seed": 7400,
  "timeoutSeconds": 900,
  "server": { "mode": "launch", "options": { "Server:MaxPlayers": "100", "Server:DevRespawn": "true", "Server:BuildInfiniteResources": "true" } },
  "variables": { "players": 50, "turboPercent": 10, "moverPercent": 30, "buildRate": 1, "turboRate": 6, "warmupSeconds": 10, "steadySeconds": 60, "cooldownSeconds": 10 },
  "parameters": [ { "players": 10 }, { "players": 25 }, { "players": 50 } ],
  "actors": [],
  "steps": [
    { "id": "spawn", "phase": "arrange", "action": "spawnActors", "count": "${players}", "prefix": "bot" },
    { "id": "join_all", "action": "connectAll", "prefix": "bot", "timeoutMilliseconds": 60000 },
    { "id": "sessions", "action": "waitFor", "condition": "server.activeSessions", "equals": "${players}", "timeoutMilliseconds": 10000 },
    { "id": "groups", "action": "actorGroup", "prefix": "bot", "groups": [ { "name": "turbo", "percent": "${turboPercent}" }, { "name": "movers", "percent": "${moverPercent}" }, { "name": "builders", "rest": true } ] },
    { "id": "build", "action": "groupBuild", "group": "builders", "ratePerSecond": "${buildRate}", "recycle": true },
    { "id": "turbo_build", "action": "groupBuild", "group": "turbo", "ratePerSecond": "${turboRate}", "recycle": true },
    { "id": "move", "action": "groupMove", "group": "movers", "pattern": "random", "radius": 60 },
    { "id": "mark_warmup", "phase": "act", "action": "mark", "text": "warmup_start players=${players}" },
    { "id": "warmup", "action": "measure", "name": "warmup", "seconds": "${warmupSeconds}" },
    { "id": "mark_measure", "action": "mark", "text": "measurement_start" },
    { "id": "steady", "action": "measure", "name": "steady", "seconds": "${steadySeconds}", "saveAs": "steady" },
    { "id": "mark_measure_end", "action": "mark", "text": "measurement_end" },
    { "id": "running", "phase": "assert", "assert": "server.running", "equals": true },
    { "id": "all_still_here", "assert": "server.activeSessions", "equals": "${players}" },
    { "id": "players_kept", "assert": "var.steady.playersMin", "equals": "${players}" },
    { "id": "pieces_placed", "assert": "group.builders.buildResults.Ok", "greaterThan": 0 },
    { "id": "turbo_placed", "assert": "group.turbo.buildResults.Ok", "greaterThan": 0 },
    { "id": "arrange_ok", "assert": "group.builders.stats.commandFailures", "equals": 0 },
    { "id": "no_stall", "assert": "var.steady.stalls", "equals": 0 },
    { "id": "no_tick_failure", "assert": "var.steady.tickFailures", "equals": 0 },
    { "id": "mark_cooldown", "phase": "act", "action": "mark", "text": "cooldown" },
    { "id": "stop", "action": "stopGroup", "group": "all", "saveAs": "groups_end" },
    { "id": "leave", "action": "disconnectAll", "prefix": "bot" },
    { "id": "cooldown", "action": "measure", "name": "cooldown", "seconds": "${cooldownSeconds}" },
    { "id": "all_gone", "phase": "assert", "action": "waitFor", "condition": "server.activeSessions", "equals": 0, "timeoutMilliseconds": 10000 }
  ]
}
