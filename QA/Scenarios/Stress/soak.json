{
  "schemaVersion": 1,
  "name": "Stress Soak (mixed gameplay)",
  "description": "Request §59-64, §116: a long run of the mixed match workload (pairs fighting, builders building and taking down, walkers, looters, a few reconnecting) for ${soakSeconds} s, sampled every ${sampleSeconds} s, to see trends: managed memory and working set (start / end / max per phase and every sample), GC counts and pause, allocation rate, sessions, build pieces, DB queue, tick percentiles. Default 300 s (5 min, development); run longer with --set soakSeconds=1800 (30 min), 3600 (1 h) or 14400 (4 h). Phases: start (memory before), soak (the trend), end (after the workload stopped, players still connected), cooldown (after they left). A phase longer than 120 s reports approximate tick percentiles (the server keeps 120 s of ticks). The server's managed memory is read after its own last GC (no forced GC: the QA API has none, and adding one would change what is measured). DevRespawn. Server:BuildInfiniteResources=true: resources cap at 500 (building.json maxResource, 50 wood pieces at cost 10) and a recycling builder places more than that in one run; resources are not what this measures, and every other placement rule (range, sight, support, occupancy, rate) still applies. No hard limit (D42); growth is for a person to judge (Baseline warnings compare with the previous run).",
  "tags": ["stress", "server", "soak", "slow", "nightly"],
  "stress": true,
  "seed": 7800,
  "timeoutSeconds": 16000,
  "server": { "mode": "launch", "options": { "Server:MaxPlayers": "100", "Server:DevRespawn": "true", "Server:BuildInfiniteResources": "true" } },
  "variables": { "players": 50, "soakSeconds": 300, "sampleSeconds": 10, "combatPercent": 30, "buildPercent": 10, "churnPercent": 6, "startSeconds": 10, "endSeconds": 15, "cooldownSeconds": 10 },
  "actors": [],
  "steps": [
    { "id": "spawn", "phase": "arrange", "action": "spawnActors", "count": "${players}", "prefix": "bot" },
    { "id": "join_all", "action": "connectAll", "prefix": "bot", "timeoutMilliseconds": 60000 },
    { "id": "sessions", "action": "waitFor", "condition": "server.activeSessions", "equals": "${players}", "timeoutMilliseconds": 10000 },
    { "id": "start", "action": "measure", "name": "start", "seconds": "${startSeconds}", "saveAs": "start" },
    { "id": "groups", "action": "actorGroup", "prefix": "bot", "groups": [
      { "name": "combat", "percent": "${combatPercent}" }, { "name": "builders", "percent": "${buildPercent}" }, { "name": "churn", "percent": "${churnPercent}" }, { "name": "roam", "rest": true } ] },
    { "id": "fight", "action": "groupCombat", "group": "combat", "pairing": "pairs", "radius": 70 },
    { "id": "build", "action": "groupBuild", "group": "builders", "ratePerSecond": 1, "recycle": true },
    { "id": "churn_move", "action": "groupMove", "group": "churn", "pattern": "random", "radius": 60 },
    { "id": "roam", "action": "groupRoles", "group": "roam", "roles": [ { "role": "move", "percent": 45 }, { "role": "sprint", "percent": 30 }, { "role": "loot", "percent": 25 } ], "switchSeconds": 30, "radius": 60 },
    { "id": "churn", "phase": "act", "action": "groupChurn", "group": "churn", "percent": 50, "cycleSeconds": 20, "cycles": 100000, "mode": "graceful" },
    { "id": "mark_soak", "action": "mark", "text": "measurement_start soak ${soakSeconds} s" },
    { "id": "soak", "action": "measure", "name": "soak", "seconds": "${soakSeconds}", "sampleSeconds": "${sampleSeconds}", "saveAs": "soak" },
    { "id": "mark_soak_end", "action": "mark", "text": "measurement_end" },
    { "id": "stop", "action": "stopGroup", "group": "all", "saveAs": "groups_end" },
    { "id": "end", "action": "measure", "name": "end", "seconds": "${endSeconds}", "saveAs": "end" },
    { "id": "running", "phase": "assert", "assert": "server.running", "equals": true },
    { "id": "all_still_here", "action": "waitFor", "condition": "server.activeSessions", "equals": "${players}", "timeoutMilliseconds": 15000 },
    { "id": "rejoined", "assert": "var.groups_end.churn.reconnectFailures", "equals": 0 },
    { "id": "no_stall", "assert": "var.soak.stalls", "equals": 0 },
    { "id": "no_tick_failure", "assert": "server.metrics.health.tickFailures", "equals": 0 },
    { "id": "mark_cooldown", "phase": "act", "action": "mark", "text": "cooldown" },
    { "id": "leave", "action": "disconnectAll", "prefix": "bot" },
    { "id": "cooldown", "action": "measure", "name": "cooldown", "seconds": "${cooldownSeconds}" },
    { "id": "all_gone", "phase": "assert", "action": "waitFor", "condition": "server.activeSessions", "equals": 0, "timeoutMilliseconds": 10000 }
  ]
}
