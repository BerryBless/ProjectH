{
  "schemaVersion": 1,
  "name": "Stress Elimination Burst",
  "description": "Request §32: at least 50 players eliminated within a few seconds, through the real zone path (no killPlayer, no damagePlayer). A real match (AirDrop off; phase 1's circle of 115 m covers the whole map, so nobody is hurt before): ${survivors} survivors walk within 4 m of the map centre, everyone else walks rings 55-100 m out. Then setZone ${zonePhase} (Arrange; flow control like a late match): the circle becomes phase 3's target (20 m) and the damage 10 health/s, applied once per second to everyone outside in one tick; the survivors follow the circle's centre. The seed (8600) is chosen so that circle's centre is 13 m from the map centre (zone centres are seeded: with another --seed the survivors may start outside it and die too). Everyone outside has the same 100 health (the zone ignores the shield), so they all die on the same zone tick about 10 s later: deaths, eliminations, placements, item drops and the alive count all in one tick. The 'burst' phase samples every second; it must see alive go from ${players} to at most ${aliveAfter} (players - 50) while the match goes on with the survivors (no winner yet). Players: at least 54 (50 eliminated + survivors). No hard limit (D42).",
  "tags": ["stress", "server", "zone", "combat", "quick"],
  "stress": true,
  "seed": 8600,
  "timeoutSeconds": 900,
  "server": { "mode": "launch", "options": { "Server:MaxPlayers": "100", "Server:AirDrop": "false", "Server:StartCountdownSeconds": "10" } },
  "variables": { "players": 60, "survivors": 4, "aliveAfter": 10, "zonePhase": 4, "walkSeconds": 15, "burstSeconds": 20, "afterSeconds": 10 },
  "parameters": [ { "players": 60, "aliveAfter": 10 }, { "players": 80, "aliveAfter": 30 }, { "players": 100, "aliveAfter": 50 } ],
  "actors": [],
  "steps": [
    { "id": "spawn", "phase": "arrange", "action": "spawnActors", "count": "${players}", "prefix": "bot" },
    { "id": "join_all", "action": "connectAll", "prefix": "bot", "timeoutMilliseconds": 60000 },
    { "id": "playing", "action": "waitFor", "condition": "match.playing", "equals": true, "timeoutMilliseconds": 30000 },
    { "id": "everyone_in", "action": "waitFor", "condition": "match.alive", "equals": "${players}", "timeoutMilliseconds": 5000 },
    { "id": "groups", "action": "actorGroup", "prefix": "bot", "groups": [ { "name": "survivors", "count": "${survivors}" }, { "name": "outside", "rest": true } ] },
    { "id": "huddle", "action": "groupMove", "group": "survivors", "pattern": "random", "center": { "x": 0, "z": 0 }, "radius": 4 },
    { "id": "spread", "action": "groupMove", "group": "outside", "pattern": "clockwise", "center": { "x": 0, "z": 0 }, "radius": 100, "sprint": true },
    { "id": "mark_warmup", "phase": "act", "action": "mark", "text": "warmup_start players=${players}" },
    { "id": "walk", "action": "measure", "name": "warmup", "seconds": "${walkSeconds}", "sampleSeconds": 1 },
    { "id": "alive_before", "phase": "assert", "assert": "match.alive", "equals": "${players}" },
    { "id": "zone_burst", "phase": "arrange", "action": "setZone", "zonePhase": "${zonePhase}", "description": "the circle shrinks to 20 m with 10 health/s (flow control)" },
    { "id": "zone_center", "action": "save", "path": "match.zone.center", "saveAs": "zc" },
    { "id": "follow", "phase": "act", "action": "groupMove", "group": "survivors", "pattern": "random", "center": "${zc}", "radius": 4 },
    { "id": "mark_measure", "action": "mark", "text": "measurement_start" },
    { "id": "burst", "action": "measure", "name": "burst", "seconds": "${burstSeconds}", "sampleSeconds": 1, "saveAs": "burst" },
    { "id": "mark_measure_end", "action": "mark", "text": "measurement_end" },
    { "id": "running", "phase": "assert", "assert": "server.running", "equals": true },
    { "id": "eliminated", "assert": "var.burst.aliveMin", "lessThan": "${aliveAfter}" },
    { "id": "burst_alive_max", "assert": "var.burst.aliveMax", "equals": "${players}" },
    { "id": "survivors_alive", "assert": "match.alive", "greaterThan": 1 },
    { "id": "match_goes_on", "assert": "match.playing", "equals": true },
    { "id": "all_still_connected", "assert": "server.activeSessions", "equals": "${players}" },
    { "id": "no_stall", "assert": "var.burst.stalls", "equals": 0 },
    { "id": "no_tick_failure", "assert": "var.burst.tickFailures", "equals": 0 },
    { "id": "mark_after", "phase": "act", "action": "mark", "text": "after" },
    { "id": "after", "action": "measure", "name": "after", "seconds": "${afterSeconds}", "saveAs": "after" },
    { "id": "stop", "action": "stopGroup", "group": "all" },
    { "id": "leave", "action": "disconnectAll", "prefix": "bot" }
  ]
}
