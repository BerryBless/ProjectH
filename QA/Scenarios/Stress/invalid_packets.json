{
  "schemaVersion": 1,
  "name": "Stress Invalid Packets",
  "description": "Request §40-42: ${abusePercent} % abusive clients among normal ones (90 + 10 at 100 players). The abusers stay in the game sending their normal input and, on the same live connection, ${rate} invalid packets per second each (unknown packet id, truncated input, garbage: the bytes of sendInvalidPackets, seeded per actor; bounded at 200/s per actor and 20 per pump tick). The server counts every one (badPackets) and kicks a connection at Server:BadPacketDisconnectThreshold (20); a kicked abuser rejoins 1 s later as a new player (the rejoin workload), like a real attacker, so the abuse lasts the whole phase. Normal players walk and fight in pairs. Judged: no normal player is kicked or disconnected, the server keeps its tick and does not crash or stall, badPackets and kicks are counted (abuseSent, kicks, rejoins). DevRespawn. No hard limit (D42).",
  "tags": ["stress", "server", "network", "faults", "security", "quick"],
  "stress": true,
  "seed": 9200,
  "timeoutSeconds": 900,
  "server": { "mode": "launch", "options": { "Server:MaxPlayers": "100", "Server:DevRespawn": "true" } },
  "variables": { "players": 50, "abusePercent": 10, "rate": 5, "fightPercent": 40, "warmupSeconds": 10, "steadySeconds": 60, "cooldownSeconds": 5 },
  "parameters": [ { "rate": 5 }, { "rate": 50 }, { "players": 100, "rate": 50 } ],
  "actors": [],
  "steps": [
    { "id": "spawn", "phase": "arrange", "action": "spawnActors", "count": "${players}", "prefix": "bot" },
    { "id": "join_all", "action": "connectAll", "prefix": "bot", "timeoutMilliseconds": 60000 },
    { "id": "sessions", "action": "waitFor", "condition": "server.activeSessions", "equals": "${players}", "timeoutMilliseconds": 10000 },
    { "id": "groups", "action": "actorGroup", "prefix": "bot", "groups": [ { "name": "abusers", "percent": "${abusePercent}" }, { "name": "fighters", "percent": "${fightPercent}" }, { "name": "walkers", "rest": true } ], "saveAs": "split" },
    { "id": "fight", "action": "groupCombat", "group": "fighters", "pairing": "pairs", "radius": 70 },
    { "id": "walk", "action": "groupMove", "group": "walkers", "pattern": "mixed", "radius": 60 },
    { "id": "bad_before", "action": "save", "path": "server.metrics.health.badPackets", "saveAs": "badBefore" },
    { "id": "mark_warmup", "phase": "act", "action": "mark", "text": "warmup_start players=${players} rate=${rate}" },
    { "id": "abuse", "action": "groupInvalidPackets", "group": "abusers", "ratePerSecond": "${rate}", "kinds": ["unknownId", "truncated", "garbage"] },
    { "id": "warmup", "action": "measure", "name": "warmup", "seconds": "${warmupSeconds}" },
    { "id": "mark_measure", "action": "mark", "text": "measurement_start" },
    { "id": "steady", "action": "measure", "name": "steady", "seconds": "${steadySeconds}", "saveAs": "steady" },
    { "id": "mark_measure_end", "action": "mark", "text": "measurement_end" },
    { "id": "stop_abuse", "action": "stopGroup", "group": "abusers", "saveAs": "abuse" },
    { "id": "running", "phase": "assert", "assert": "server.running", "equals": true },
    { "id": "bad_counted", "assert": "var.steady.badPackets", "greaterThan": 0 },
    { "id": "abusers_kicked", "assert": "var.abuse.kicks", "greaterThan": 0 },
    { "id": "fighters_kept", "assert": "group.fighters.kicked", "equals": 0 },
    { "id": "walkers_kept", "assert": "group.walkers.kicked", "equals": 0 },
    { "id": "fighters_in", "assert": "group.fighters.joined", "equals": "${split.groups.fighters}" },
    { "id": "walkers_in", "assert": "group.walkers.joined", "equals": "${split.groups.walkers}" },
    { "id": "shots_landed", "assert": "group.fighters.hitsLanded", "greaterThan": 0 },
    { "id": "no_stall", "assert": "var.steady.stalls", "equals": 0 },
    { "id": "no_tick_failure", "assert": "var.steady.tickFailures", "equals": 0 },
    { "id": "mark_cooldown", "phase": "act", "action": "mark", "text": "cooldown" },
    { "id": "stop", "action": "stopGroup", "group": "all" },
    { "id": "leave", "action": "disconnectAll", "prefix": "bot" },
    { "id": "cooldown", "action": "measure", "name": "cooldown", "seconds": "${cooldownSeconds}" },
    { "id": "all_gone", "phase": "assert", "action": "waitFor", "condition": "server.activeSessions", "equals": 0, "timeoutMilliseconds": 10000 }
  ]
}
