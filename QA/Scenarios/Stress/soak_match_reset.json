{
  "schemaVersion": 1,
  "name": "Stress Soak (match reset loop)",
  "description": "Request §59-64 (match repetition version): ten matches in a row, Start -> Play ${matchSeconds} s -> Finish -> Reset, with the same clients connected the whole time (pairs fighting, builders building and taking down, walkers and looters). One measure phase per match (match_01 ... match_10): compare managed memory, working set, GC, build pieces and sessions at the start, after match 1, 5 and 10 (each phase's end values, and the samples). The match is ended by forceMatchState finish (flow control, not gameplay); between matches the server resets the world (every piece and item cleared, everyone back on a drop point, unarmed): the groups' re-arm gives the fighters their weapon and spot again and the builders walk back to their sites. Dead fighters stay dead until the next match (a real match). A match (not DevRespawn), StartCountdownSeconds 3. Server:BuildInfiniteResources=true: resources cap at 500 (building.json maxResource, 50 wood pieces at cost 10) and a recycling builder places more than that in one run; resources are not what this measures, and every other placement rule (range, sight, support, occupancy, rate) still applies. No hard limit (D42).",
  "tags": ["stress", "server", "soak", "slow", "nightly"],
  "stress": true,
  "seed": 7900,
  "timeoutSeconds": 3600,
  "server": {"mode": "launch", "options": {"Server:MaxPlayers": "100", "Server:StartCountdownSeconds": "3", "Server:BuildInfiniteResources": "true"}},
  "variables": {"players": 50, "matchSeconds": 30, "combatPercent": 30, "buildPercent": 10, "startSeconds": 10, "cooldownSeconds": 10},
  "actors": [],
  "steps": [
    {"id": "spawn", "phase": "arrange", "action": "spawnActors", "count": "${players}", "prefix": "bot"},
    {"id": "join_all", "action": "connectAll", "prefix": "bot", "timeoutMilliseconds": 60000},
    {"id": "playing_first", "action": "waitFor", "condition": "match.playing", "equals": true, "timeoutMilliseconds": 30000},
    {"id": "everyone_in", "action": "waitFor", "condition": "match.alive", "equals": "${players}", "timeoutMilliseconds": 5000},
    {"id": "start", "action": "measure", "name": "start", "seconds": "${startSeconds}", "saveAs": "start"},
    {"id": "groups", "action": "actorGroup", "prefix": "bot", "groups": [{"name": "combat", "percent": "${combatPercent}"}, {"name": "builders", "percent": "${buildPercent}"}, {"name": "roam", "rest": true}]},
    {"id": "fight", "action": "groupCombat", "group": "combat", "pairing": "pairs", "radius": 60, "hitPercent": 15},
    {"id": "build", "action": "groupBuild", "group": "builders", "ratePerSecond": 1, "recycle": true},
    {"id": "roam", "action": "groupRoles", "group": "roam", "roles": [{"role": "move", "percent": 50}, {"role": "sprint", "percent": 25}, {"role": "loot", "percent": 25}], "switchSeconds": 20, "radius": 50},
    {"id": "m01", "phase": "act", "action": "measure", "name": "match_01", "seconds": "${matchSeconds}", "saveAs": "match_01"},
    {"id": "m01_finish", "phase": "arrange", "action": "forceMatchState", "state": "finish", "description": "end match 1 (flow control)"},
    {"id": "m01_over", "phase": "act", "action": "waitFor", "condition": "match.playing", "equals": false, "timeoutMilliseconds": 10000},
    {"id": "m02_playing", "phase": "act", "action": "waitFor", "condition": "match.playing", "equals": true, "timeoutMilliseconds": 30000, "description": "match 2 started (reset -> countdown -> Playing)"},
    {"id": "m02", "phase": "act", "action": "measure", "name": "match_02", "seconds": "${matchSeconds}", "saveAs": "match_02"},
    {"id": "m02_finish", "phase": "arrange", "action": "forceMatchState", "state": "finish", "description": "end match 2 (flow control)"},
    {"id": "m02_over", "phase": "act", "action": "waitFor", "condition": "match.playing", "equals": false, "timeoutMilliseconds": 10000},
    {"id": "m03_playing", "phase": "act", "action": "waitFor", "condition": "match.playing", "equals": true, "timeoutMilliseconds": 30000, "description": "match 3 started (reset -> countdown -> Playing)"},
    {"id": "m03", "phase": "act", "action": "measure", "name": "match_03", "seconds": "${matchSeconds}", "saveAs": "match_03"},
    {"id": "m03_finish", "phase": "arrange", "action": "forceMatchState", "state": "finish", "description": "end match 3 (flow control)"},
    {"id": "m03_over", "phase": "act", "action": "waitFor", "condition": "match.playing", "equals": false, "timeoutMilliseconds": 10000},
    {"id": "m04_playing", "phase": "act", "action": "waitFor", "condition": "match.playing", "equals": true, "timeoutMilliseconds": 30000, "description": "match 4 started (reset -> countdown -> Playing)"},
    {"id": "m04", "phase": "act", "action": "measure", "name": "match_04", "seconds": "${matchSeconds}", "saveAs": "match_04"},
    {"id": "m04_finish", "phase": "arrange", "action": "forceMatchState", "state": "finish", "description": "end match 4 (flow control)"},
    {"id": "m04_over", "phase": "act", "action": "waitFor", "condition": "match.playing", "equals": false, "timeoutMilliseconds": 10000},
    {"id": "m05_playing", "phase": "act", "action": "waitFor", "condition": "match.playing", "equals": true, "timeoutMilliseconds": 30000, "description": "match 5 started (reset -> countdown -> Playing)"},
    {"id": "m05", "phase": "act", "action": "measure", "name": "match_05", "seconds": "${matchSeconds}", "saveAs": "match_05"},
    {"id": "m05_finish", "phase": "arrange", "action": "forceMatchState", "state": "finish", "description": "end match 5 (flow control)"},
    {"id": "m05_over", "phase": "act", "action": "waitFor", "condition": "match.playing", "equals": false, "timeoutMilliseconds": 10000},
    {"id": "m06_playing", "phase": "act", "action": "waitFor", "condition": "match.playing", "equals": true, "timeoutMilliseconds": 30000, "description": "match 6 started (reset -> countdown -> Playing)"},
    {"id": "m06", "phase": "act", "action": "measure", "name": "match_06", "seconds": "${matchSeconds}", "saveAs": "match_06"},
    {"id": "m06_finish", "phase": "arrange", "action": "forceMatchState", "state": "finish", "description": "end match 6 (flow control)"},
    {"id": "m06_over", "phase": "act", "action": "waitFor", "condition": "match.playing", "equals": false, "timeoutMilliseconds": 10000},
    {"id": "m07_playing", "phase": "act", "action": "waitFor", "condition": "match.playing", "equals": true, "timeoutMilliseconds": 30000, "description": "match 7 started (reset -> countdown -> Playing)"},
    {"id": "m07", "phase": "act", "action": "measure", "name": "match_07", "seconds": "${matchSeconds}", "saveAs": "match_07"},
    {"id": "m07_finish", "phase": "arrange", "action": "forceMatchState", "state": "finish", "description": "end match 7 (flow control)"},
    {"id": "m07_over", "phase": "act", "action": "waitFor", "condition": "match.playing", "equals": false, "timeoutMilliseconds": 10000},
    {"id": "m08_playing", "phase": "act", "action": "waitFor", "condition": "match.playing", "equals": true, "timeoutMilliseconds": 30000, "description": "match 8 started (reset -> countdown -> Playing)"},
    {"id": "m08", "phase": "act", "action": "measure", "name": "match_08", "seconds": "${matchSeconds}", "saveAs": "match_08"},
    {"id": "m08_finish", "phase": "arrange", "action": "forceMatchState", "state": "finish", "description": "end match 8 (flow control)"},
    {"id": "m08_over", "phase": "act", "action": "waitFor", "condition": "match.playing", "equals": false, "timeoutMilliseconds": 10000},
    {"id": "m09_playing", "phase": "act", "action": "waitFor", "condition": "match.playing", "equals": true, "timeoutMilliseconds": 30000, "description": "match 9 started (reset -> countdown -> Playing)"},
    {"id": "m09", "phase": "act", "action": "measure", "name": "match_09", "seconds": "${matchSeconds}", "saveAs": "match_09"},
    {"id": "m09_finish", "phase": "arrange", "action": "forceMatchState", "state": "finish", "description": "end match 9 (flow control)"},
    {"id": "m09_over", "phase": "act", "action": "waitFor", "condition": "match.playing", "equals": false, "timeoutMilliseconds": 10000},
    {"id": "m10_playing", "phase": "act", "action": "waitFor", "condition": "match.playing", "equals": true, "timeoutMilliseconds": 30000, "description": "match 10 started (reset -> countdown -> Playing)"},
    {"id": "m10", "phase": "act", "action": "measure", "name": "match_10", "seconds": "${matchSeconds}", "saveAs": "match_10"},
    {"id": "m10_finish", "phase": "arrange", "action": "forceMatchState", "state": "finish", "description": "end match 10 (flow control)"},
    {"id": "m10_over", "phase": "act", "action": "waitFor", "condition": "match.playing", "equals": false, "timeoutMilliseconds": 10000},
    {"id": "stop", "action": "stopGroup", "group": "all", "saveAs": "groups_end"},
    {"id": "running", "phase": "assert", "assert": "server.running", "equals": true},
    {"id": "all_still_here", "assert": "server.activeSessions", "equals": "${players}"},
    {"id": "no_error_reset", "assert": "server.metrics.health.matchResets", "equals": 0},
    {"id": "no_tick_failure", "assert": "server.metrics.health.tickFailures", "equals": 0},
    {"id": "no_stall", "assert": "server.metrics.health.stalls", "equals": 0},
    {"id": "leave", "phase": "act", "action": "disconnectAll", "prefix": "bot"},
    {"id": "cooldown", "action": "measure", "name": "cooldown", "seconds": "${cooldownSeconds}"}
  ]
}
