{
  "schemaVersion": 1,
  "name": "Stress Mixed Match",
  "description": "Request §50-53, §113: a match-like mix at once, all through real input. The request's ratios overlap (70% moving, 40% sprint, 30% combat, 20% loot, 20% building with 10% turbo); here they are exclusive groups whose behaviours cover them: ${combatPercent}% fight in pairs (strafing, chasing, real shots, deaths and respawns), ${buildPercent}% build and ${turboPercent}% turbo-build on their own sites (recycled), ${lagPercent}% walk behind a ${lagMs} ms each-way network delay (fault proxy: high ping), ${churnPercent}% walk and reconnect in cycles (graceful disconnect -> reconnect), and the rest switch roles every ${switchSeconds} s by seed (walk / sprint / loot: walk to known items and press Interact, drop and use medkits). Moving at any time: walkers, looters, fighters strafing or chasing (more than 70%); sprinting: sprint role, looters and chasers. Ratios are variables (--set combatPercent=40 or a parameter set). DevRespawn keeps the count (no zone: zone damage needs the match flow, see final_zone / soak_match_reset). Players: 50 and 100 first, then 10/25/75. Server:BuildInfiniteResources=true: resources cap at 500 (building.json maxResource, 50 wood pieces at cost 10) and a recycling builder places more than that in one run; resources are not what this measures, and every other placement rule (range, sight, support, occupancy, rate) still applies. No hard limit (D42).",
  "tags": ["stress", "server", "movement", "combat", "building", "network", "quick"],
  "stress": true,
  "seed": 7500,
  "timeoutSeconds": 900,
  "server": { "mode": "launch", "options": { "Server:MaxPlayers": "100", "Server:DevRespawn": "true", "Server:BuildInfiniteResources": "true" } },
  "variables": {
    "players": 50, "combatPercent": 30, "buildPercent": 10, "turboPercent": 10, "lagPercent": 10, "lagMs": 50, "churnPercent": 5, "switchSeconds": 20,
    "warmupSeconds": 10, "steadySeconds": 60, "cooldownSeconds": 10
  },
  "parameters": [ { "players": 50 }, { "players": 100 }, { "players": 10 }, { "players": 25 }, { "players": 75 } ],
  "actors": [],
  "steps": [
    { "id": "spawn", "phase": "arrange", "action": "spawnActors", "count": "${players}", "prefix": "bot" },
    { "id": "groups", "action": "actorGroup", "prefix": "bot", "groups": [
      { "name": "combat", "percent": "${combatPercent}" }, { "name": "builders", "percent": "${buildPercent}" }, { "name": "turbo", "percent": "${turboPercent}" },
      { "name": "lag", "percent": "${lagPercent}", "proxy": true }, { "name": "churn", "percent": "${churnPercent}" }, { "name": "roam", "rest": true } ] },
    { "id": "join_all", "action": "connectAll", "prefix": "bot", "timeoutMilliseconds": 60000 },
    { "id": "sessions", "action": "waitFor", "condition": "server.activeSessions", "equals": "${players}", "timeoutMilliseconds": 10000 },
    { "id": "fight", "action": "groupCombat", "group": "combat", "pairing": "pairs", "weapon": "Vesper AR", "radius": 70, "spacing": 12, "pairDistance": 10 },
    { "id": "build", "action": "groupBuild", "group": "builders", "ratePerSecond": 1, "recycle": true },
    { "id": "turbo_build", "action": "groupBuild", "group": "turbo", "ratePerSecond": 6, "recycle": true },
    { "id": "lag_fault", "action": "groupNetworkFault", "group": "lag", "latencyMs": "${lagMs}", "jitterMs": 5 },
    { "id": "lag_move", "action": "groupMove", "group": "lag", "pattern": "mixed", "radius": 60, "sprintPercent": 40 },
    { "id": "churn_move", "action": "groupMove", "group": "churn", "pattern": "random", "radius": 60 },
    { "id": "roam", "action": "groupRoles", "group": "roam", "roles": [ { "role": "move", "percent": 45 }, { "role": "sprint", "percent": 30 }, { "role": "loot", "percent": 25 } ], "switchSeconds": "${switchSeconds}", "radius": 60 },
    { "id": "mark_warmup", "phase": "act", "action": "mark", "text": "warmup_start players=${players}" },
    { "id": "warmup", "action": "measure", "name": "warmup", "seconds": "${warmupSeconds}" },
    { "id": "churn", "action": "groupChurn", "group": "churn", "percent": 100, "cycleSeconds": 15, "cycles": 1000, "mode": "graceful" },
    { "id": "mark_measure", "action": "mark", "text": "measurement_start" },
    { "id": "steady", "action": "measure", "name": "steady", "seconds": "${steadySeconds}", "saveAs": "steady" },
    { "id": "mark_measure_end", "action": "mark", "text": "measurement_end" },
    { "id": "churn_end", "action": "stopGroup", "group": "churn", "saveAs": "churned" },
    { "id": "running", "phase": "assert", "assert": "server.running", "equals": true },
    { "id": "all_back", "action": "waitFor", "condition": "server.activeSessions", "equals": "${players}", "timeoutMilliseconds": 15000 },
    { "id": "shots_landed", "assert": "group.combat.hitsLanded", "greaterThan": 0 },
    { "id": "pieces_placed", "assert": "group.builders.buildResults.Ok", "greaterThan": 0 },
    { "id": "rejoined", "assert": "var.churned.reconnectFailures", "equals": 0 },
    { "id": "no_duplicates", "assert": "var.churned.duplicates", "equals": 0 },
    { "id": "no_stall", "assert": "var.steady.stalls", "equals": 0 },
    { "id": "no_tick_failure", "assert": "var.steady.tickFailures", "equals": 0 },
    { "id": "mark_cooldown", "phase": "act", "action": "mark", "text": "cooldown" },
    { "id": "stop", "action": "stopGroup", "group": "all", "saveAs": "groups_end" },
    { "id": "leave", "action": "disconnectAll", "prefix": "bot" },
    { "id": "cooldown", "action": "measure", "name": "cooldown", "seconds": "${cooldownSeconds}" },
    { "id": "all_gone", "phase": "assert", "action": "waitFor", "condition": "server.activeSessions", "equals": 0, "timeoutMilliseconds": 10000 }
  ]
}
