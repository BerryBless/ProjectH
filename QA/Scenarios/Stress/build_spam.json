{
  "schemaVersion": 1,
  "name": "Stress Build Spam",
  "description": "Request §43: build requests over the limits, among real builders. ${spamPercent} % of the players turn build mode on and send ${spamRate} build requests per second each, at once, without the aim ticks or the spacing a correct client keeps (random walls, floors and ramps in the cells around them). Two tiers by parameter: below the server's network limit (building.json maxRequestsPerSecond 20) the requests reach the player's 8-slot queue, which the game loop drains one per minimumBuildInterval (0.1 s): the rest are answered RateLimited at once (no memory grows); above 20/s the extra requests are bad packets (BuildRate) and the connection is kicked at 20, then the spammer rejoins (rejoin workload). The others build normally on their own sites at 1/s (recycling) and walk: their requests must still be placed (no starvation) and none of them may be kicked. The spammers' answers by code are saved (group.spammers.buildResults). Server:BuildInfiniteResources=true (as building.json: resources are not what this measures). DevRespawn. No hard limit (D42).",
  "tags": ["stress", "server", "building", "network", "security", "quick"],
  "stress": true,
  "seed": 9300,
  "timeoutSeconds": 900,
  "server": { "mode": "launch", "options": { "Server:MaxPlayers": "100", "Server:DevRespawn": "true", "Server:BuildInfiniteResources": "true" } },
  "variables": { "players": 50, "spamPercent": 10, "buildPercent": 40, "spamRate": 15, "warmupSeconds": 10, "steadySeconds": 60, "cooldownSeconds": 5 },
  "parameters": [ { "spamRate": 15 }, { "spamRate": 40 } ],
  "actors": [],
  "steps": [
    { "id": "spawn", "phase": "arrange", "action": "spawnActors", "count": "${players}", "prefix": "bot" },
    { "id": "join_all", "action": "connectAll", "prefix": "bot", "timeoutMilliseconds": 60000 },
    { "id": "sessions", "action": "waitFor", "condition": "server.activeSessions", "equals": "${players}", "timeoutMilliseconds": 10000 },
    { "id": "groups", "action": "actorGroup", "prefix": "bot", "groups": [ { "name": "spammers", "percent": "${spamPercent}" }, { "name": "builders", "percent": "${buildPercent}" }, { "name": "walkers", "rest": true } ], "saveAs": "split" },
    { "id": "build", "action": "groupBuild", "group": "builders", "ratePerSecond": 1, "recycle": true },
    { "id": "walk", "action": "groupMove", "group": "walkers", "pattern": "mixed", "radius": 60 },
    { "id": "mark_warmup", "phase": "act", "action": "mark", "text": "warmup_start players=${players} spam=${spamRate}" },
    { "id": "spam", "action": "groupBuildSpam", "group": "spammers", "ratePerSecond": "${spamRate}", "resources": 0 },
    { "id": "warmup", "action": "measure", "name": "warmup", "seconds": "${warmupSeconds}" },
    { "id": "mark_measure", "action": "mark", "text": "measurement_start" },
    { "id": "steady", "action": "measure", "name": "steady", "seconds": "${steadySeconds}", "saveAs": "steady" },
    { "id": "mark_measure_end", "action": "mark", "text": "measurement_end" },
    { "id": "stop_spam", "action": "stopGroup", "group": "spammers", "saveAs": "spam" },
    { "id": "spam_codes", "phase": "assert", "action": "save", "path": "group.spammers.buildResults", "saveAs": "spamCodes" },
    { "id": "builder_codes", "action": "save", "path": "group.builders.buildResults", "saveAs": "builderCodes" },
    { "id": "running", "assert": "server.running", "equals": true },
    { "id": "spam_answered", "assert": "group.spammers.stats.abuseSent", "greaterThan": 0 },
    { "id": "builders_placed", "assert": "group.builders.buildResults.Ok", "greaterThan": 0 },
    { "id": "builders_kept", "assert": "group.builders.kicked", "equals": 0 },
    { "id": "builders_in", "assert": "group.builders.joined", "equals": "${split.groups.builders}" },
    { "id": "walkers_in", "assert": "group.walkers.joined", "equals": "${split.groups.walkers}" },
    { "id": "no_stall", "assert": "var.steady.stalls", "equals": 0 },
    { "id": "no_tick_failure", "assert": "var.steady.tickFailures", "equals": 0 },
    { "id": "mark_cooldown", "phase": "act", "action": "mark", "text": "cooldown" },
    { "id": "stop", "action": "stopGroup", "group": "all" },
    { "id": "leave", "action": "disconnectAll", "prefix": "bot" },
    { "id": "cooldown", "action": "measure", "name": "cooldown", "seconds": "${cooldownSeconds}" },
    { "id": "all_gone", "phase": "assert", "action": "waitFor", "condition": "server.activeSessions", "equals": 0, "timeoutMilliseconds": 10000 }
  ]
}
