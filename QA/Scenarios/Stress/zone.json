{
  "schemaVersion": 1,
  "name": "Stress Zone",
  "description": "Request §31: a real match with many players outside the zone and some crossing in and out. The match flow runs (not DevRespawn; AirDrop off so everyone starts on a drop point and is never a transport rider, whom the zone skips); setZone ${zonePhase} (Arrange) makes the circle the previous phase's target (radius 70 for phase 2) with phase ${zonePhase}'s damage (2 health/s, once per second to everyone outside, in one tick; the shield does not stop it). Groups around the zone centre read from /qa/match: ${outsidePercent} % walk rings 77-140 m out (most of them outside), ${crossPercent} % walk a radial pattern between 14 m and 52-95 m (in and out of the circle), the rest stay within 25 m (inside). Judged (health as each member's own snapshot shows it; zone damage sends no DamageTaken packet): outsiders lose health, the inside group (which may lose some while it walks in from its drop point during warmup, sprinting) loses (almost) none during steady: its average may drop by at most 1, one late walker at 100 players and ends healthier than the outsiders, nobody dies within warmup + steady (keep (warmupSeconds + steadySeconds) x 2 below 100 health: 45 s at most). A countdown of 10 s lets everyone join before the match starts. With seed 8600 the circle is centred at (25, 20), so the outside is mostly the south-west half. No hard limit (D42).",
  "tags": ["stress", "server", "zone", "quick"],
  "stress": true,
  "seed": 8600,
  "timeoutSeconds": 900,
  "server": { "mode": "launch", "options": { "Server:MaxPlayers": "100", "Server:AirDrop": "false", "Server:StartCountdownSeconds": "10" } },
  "variables": { "players": 50, "zonePhase": 2, "outsidePercent": 50, "crossPercent": 20, "warmupSeconds": 15, "steadySeconds": 30, "cooldownSeconds": 5 },
  "parameters": [ { "players": 25 }, { "players": 50 }, { "players": 100 } ],
  "actors": [],
  "steps": [
    { "id": "spawn", "phase": "arrange", "action": "spawnActors", "count": "${players}", "prefix": "bot" },
    { "id": "join_all", "action": "connectAll", "prefix": "bot", "timeoutMilliseconds": 60000 },
    { "id": "playing", "action": "waitFor", "condition": "match.playing", "equals": true, "timeoutMilliseconds": 30000 },
    { "id": "everyone_in", "action": "waitFor", "condition": "match.alive", "equals": "${players}", "timeoutMilliseconds": 5000 },
    { "id": "zone", "action": "setZone", "zonePhase": "${zonePhase}" },
    { "id": "zone_now", "action": "waitFor", "condition": "match.zone.phase", "equals": "${zonePhase}", "timeoutMilliseconds": 2000 },
    { "id": "zone_center", "action": "save", "path": "match.zone.center", "saveAs": "zc" },
    { "id": "zone_state", "action": "save", "path": "match.zone", "saveAs": "zoneState" },
    { "id": "groups", "action": "actorGroup", "prefix": "bot", "groups": [ { "name": "outside", "percent": "${outsidePercent}" }, { "name": "crossers", "percent": "${crossPercent}" }, { "name": "inside", "rest": true } ] },
    { "id": "go_out", "action": "groupMove", "group": "outside", "pattern": "clockwise", "center": "${zc}", "radius": 140, "sprintPercent": 50 },
    { "id": "cross", "action": "groupMove", "group": "crossers", "pattern": "radial", "center": "${zc}", "radius": 95, "sprint": true },
    { "id": "stay_in", "action": "groupMove", "group": "inside", "pattern": "random", "center": "${zc}", "radius": 25, "sprint": true },
    { "id": "mark_warmup", "phase": "act", "action": "mark", "text": "warmup_start players=${players} zone=${zonePhase}" },
    { "id": "warmup", "action": "measure", "name": "warmup", "seconds": "${warmupSeconds}" },
    { "id": "inside_start", "action": "save", "path": "group.inside.healthAvg", "saveAs": "insideStart" },
    { "id": "mark_measure", "action": "mark", "text": "measurement_start" },
    { "id": "steady", "action": "measure", "name": "steady", "seconds": "${steadySeconds}", "saveAs": "steady" },
    { "id": "mark_measure_end", "action": "mark", "text": "measurement_end" },
    { "id": "outside_health", "phase": "assert", "action": "save", "path": "group.outside.healthAvg", "saveAs": "outsideHealth" },
    { "id": "cross_health", "action": "save", "path": "group.crossers.healthAvg", "saveAs": "crossHealth" },
    { "id": "inside_health", "action": "save", "path": "group.inside.healthAvg", "saveAs": "insideHealth" },
    { "id": "running", "assert": "server.running", "equals": true },
    { "id": "all_still_here", "assert": "server.activeSessions", "equals": "${players}" },
    { "id": "still_playing", "assert": "match.playing", "equals": true },
    { "id": "nobody_died", "assert": "var.steady.aliveMin", "equals": "${players}" },
    { "id": "outside_hurt", "assert": "group.outside.healthAvg", "lessThan": 100 },
    { "id": "inside_safer", "assert": "group.inside.healthAvg", "greaterThan": "${outsideHealth}" },
    { "id": "inside_kept", "assert": "group.inside.healthAvg", "approximately": "${insideStart}", "tolerance": 1 },
    { "id": "no_stall", "assert": "var.steady.stalls", "equals": 0 },
    { "id": "no_tick_failure", "assert": "var.steady.tickFailures", "equals": 0 },
    { "id": "mark_cooldown", "phase": "act", "action": "mark", "text": "cooldown" },
    { "id": "stop", "action": "stopGroup", "group": "all" },
    { "id": "leave", "action": "disconnectAll", "prefix": "bot" },
    { "id": "cooldown", "action": "measure", "name": "cooldown", "seconds": "${cooldownSeconds}" }
  ]
}
