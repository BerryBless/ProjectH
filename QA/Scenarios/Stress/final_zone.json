{
  "schemaVersion": 1,
  "name": "Stress Final Zone (dense area)",
  "description": "Request §54-55, §115: the end of a match: ${players} players packed into a circle of ${radius} m (the flat centre of the map), everyone in everyone's snapshot and line of fire. ${combatPercent}% fight in pairs at ${pairDistance} m on spots ${spacing} m apart (real shots, damage, deaths; the re-arm puts the respawned back on their spot), ${buildPercent}% build and take down their structures on the free sites nearest the centre (real requests and real shots at the pieces, collapses), the rest run around inside the circle with sprint and jumps. DevRespawn keeps the count steady; zone damage itself needs the match flow and is left to the match scenarios (soak_match_reset, the phase-B elimination burst). Server:BuildInfiniteResources=true: resources cap at 500 (building.json maxResource, 50 wood pieces at cost 10) and a recycling builder places more than that in one run; resources are not what this measures, and every other placement rule (range, sight, support, occupancy, rate) still applies. No hard limit (D42).",
  "tags": ["stress", "server", "combat", "building", "quick"],
  "stress": true,
  "seed": 7700,
  "timeoutSeconds": 900,
  "server": { "mode": "launch", "options": { "Server:MaxPlayers": "100", "Server:DevRespawn": "true", "Server:BuildInfiniteResources": "true" } },
  "variables": { "players": 40, "radius": 25, "combatPercent": 50, "buildPercent": 20, "pairDistance": 6, "spacing": 7, "warmupSeconds": 10, "steadySeconds": 60, "cooldownSeconds": 10 },
  "parameters": [ { "players": 30 }, { "players": 40 }, { "players": 50 } ],
  "actors": [],
  "steps": [
    { "id": "spawn", "phase": "arrange", "action": "spawnActors", "count": "${players}", "prefix": "bot" },
    { "id": "join_all", "action": "connectAll", "prefix": "bot", "timeoutMilliseconds": 60000 },
    { "id": "sessions", "action": "waitFor", "condition": "server.activeSessions", "equals": "${players}", "timeoutMilliseconds": 10000 },
    { "id": "groups", "action": "actorGroup", "prefix": "bot", "groups": [ { "name": "combat", "percent": "${combatPercent}" }, { "name": "builders", "percent": "${buildPercent}" }, { "name": "runners", "rest": true } ] },
    { "id": "fight", "action": "groupCombat", "group": "combat", "pairing": "pairs", "center": { "x": 0, "z": 0 }, "radius": "${radius}", "spacing": "${spacing}", "pairDistance": "${pairDistance}", "hitPercent": 30 },
    { "id": "build", "action": "groupBuild", "group": "builders", "center": { "x": 0, "z": 0 }, "ratePerSecond": 2, "recycle": true },
    { "id": "run", "action": "groupMove", "group": "runners", "pattern": "random", "center": { "x": 0, "z": 0 }, "radius": "${radius}", "sprintPercent": 60, "jumpEverySeconds": 4 },
    { "id": "mark_warmup", "phase": "act", "action": "mark", "text": "warmup_start players=${players}" },
    { "id": "warmup", "action": "measure", "name": "warmup", "seconds": "${warmupSeconds}" },
    { "id": "mark_measure", "action": "mark", "text": "measurement_start" },
    { "id": "steady", "action": "measure", "name": "steady", "seconds": "${steadySeconds}", "saveAs": "steady" },
    { "id": "mark_measure_end", "action": "mark", "text": "measurement_end" },
    { "id": "running", "phase": "assert", "assert": "server.running", "equals": true },
    { "id": "all_still_here", "assert": "server.activeSessions", "equals": "${players}" },
    { "id": "shots_landed", "assert": "group.combat.hitsLanded", "greaterThan": 0 },
    { "id": "pieces_placed", "assert": "group.builders.buildResults.Ok", "greaterThan": 0 },
    { "id": "no_stall", "assert": "var.steady.stalls", "equals": 0 },
    { "id": "no_tick_failure", "assert": "var.steady.tickFailures", "equals": 0 },
    { "id": "mark_cooldown", "phase": "act", "action": "mark", "text": "cooldown" },
    { "id": "stop", "action": "stopGroup", "group": "all", "saveAs": "groups_end" },
    { "id": "leave", "action": "disconnectAll", "prefix": "bot" },
    { "id": "cooldown", "action": "measure", "name": "cooldown", "seconds": "${cooldownSeconds}" },
    { "id": "all_gone", "phase": "assert", "action": "waitFor", "condition": "server.activeSessions", "equals": 0, "timeoutMilliseconds": 10000 }
  ]
}
