{
  "schemaVersion": 1,
  "name": "Stress Movement",
  "description": "Request §11-13, §110: everyone keeps moving through the real input path (steering, body and aim yaw, sprint, jump). Four movement groups side by side by actor index (§12): clockwise and counter-clockwise rings, centre<->edge runs and seeded random waypoints, each actor on its own ring and start angle so the group spreads over the map (radius ${radius} m) instead of gathering. ${sprintPercent}% sprint, everyone jumps every ${jumpEverySeconds} s (offset per actor). DevRespawn, MaxPlayers 100, QA events off. No hard limit (D42); judged on the steady phase.",
  "tags": ["stress", "server", "movement", "quick"],
  "stress": true,
  "seed": 7200,
  "timeoutSeconds": 900,
  "server": { "mode": "launch", "options": { "Server:MaxPlayers": "100", "Server:DevRespawn": "true" } },
  "variables": { "players": 50, "radius": 60, "sprintPercent": 40, "jumpEverySeconds": 6, "warmupSeconds": 10, "steadySeconds": 60, "cooldownSeconds": 10 },
  "parameters": [ { "players": 10 }, { "players": 25 }, { "players": 50 }, { "players": 75 }, { "players": 100 } ],
  "actors": [],
  "steps": [
    { "id": "spawn", "phase": "arrange", "action": "spawnActors", "count": "${players}", "prefix": "bot" },
    { "id": "join_all", "action": "connectAll", "prefix": "bot", "timeoutMilliseconds": 60000 },
    { "id": "sessions", "action": "waitFor", "condition": "server.activeSessions", "equals": "${players}", "timeoutMilliseconds": 10000 },
    { "id": "groups", "action": "actorGroup", "prefix": "bot", "groups": [ { "name": "movers", "rest": true } ] },
    { "id": "move", "phase": "act", "action": "groupMove", "group": "movers", "pattern": "mixed", "radius": "${radius}", "sprintPercent": "${sprintPercent}", "jumpEverySeconds": "${jumpEverySeconds}" },
    { "id": "mark_warmup", "action": "mark", "text": "warmup_start players=${players}" },
    { "id": "warmup", "action": "measure", "name": "warmup", "seconds": "${warmupSeconds}" },
    { "id": "mark_measure", "action": "mark", "text": "measurement_start" },
    { "id": "steady", "action": "measure", "name": "steady", "seconds": "${steadySeconds}", "saveAs": "steady" },
    { "id": "mark_measure_end", "action": "mark", "text": "measurement_end" },
    { "id": "running", "phase": "assert", "assert": "server.running", "equals": true },
    { "id": "all_still_here", "assert": "server.activeSessions", "equals": "${players}" },
    { "id": "players_kept", "assert": "var.steady.playersMin", "equals": "${players}" },
    { "id": "no_stall", "assert": "var.steady.stalls", "equals": 0 },
    { "id": "no_tick_failure", "assert": "var.steady.tickFailures", "equals": 0 },
    { "id": "mark_cooldown", "phase": "act", "action": "mark", "text": "cooldown" },
    { "id": "stop", "action": "stopGroup", "group": "movers" },
    { "id": "leave", "action": "disconnectAll", "prefix": "bot" },
    { "id": "cooldown", "action": "measure", "name": "cooldown", "seconds": "${cooldownSeconds}" },
    { "id": "all_gone", "phase": "assert", "action": "waitFor", "condition": "server.activeSessions", "equals": 0, "timeoutMilliseconds": 10000 }
  ]
}
