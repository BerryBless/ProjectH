{
  "schemaVersion": 1,
  "name": "Stress Lag Compensation",
  "description": "Request §18-19: real fights while the players sit at different pings. Four equal groups (25 % each) play behind their own fault proxy with ${ping0} / ${ping50} / ${ping100} / ${ping200} ms latency each way plus ${jitterMs} ms jitter (the latency_sweep convention: 'ping' = the proxy's latencyMs in each direction, so the round trip is about twice that). Each group fights in pairs in its own quarter of the map (the spots of one groupCombat call are not shared with another, so each group gets its own centre): strafing, chasing, aiming at its partner as its own (late) snapshots show it, bursts of single presses (weapon fire interval), ${hitPercent} % of bursts at the chest; the server rewinds each shot to the shooter's view tick (12 ticks = 0.4 s window). Saved per group: HitConfirmed received, presses, the connections' RTT. Hits are asserted for the 0/50/100 ms groups only: at 200 ms each way the round trip is at the edge of the rewind window (Docs/QA.md), so the 200 group's hit count is reported, not judged. DevRespawn (deaths respawn, the group re-arm gives the weapon back). No hard limit (D42).",
  "tags": ["stress", "server", "network", "combat", "quick"],
  "stress": true,
  "seed": 8100,
  "timeoutSeconds": 900,
  "server": { "mode": "launch", "options": { "Server:MaxPlayers": "100", "Server:DevRespawn": "true" } },
  "variables": { "players": 50, "ping0": 0, "ping50": 50, "ping100": 100, "ping200": 200, "jitterMs": 5, "hitPercent": 60, "warmupSeconds": 10, "steadySeconds": 60, "cooldownSeconds": 10 },
  "parameters": [ { "players": 20 }, { "players": 50 }, { "players": 100 } ],
  "actors": [],
  "steps": [
    { "id": "spawn", "phase": "arrange", "action": "spawnActors", "count": "${players}", "prefix": "bot" },
    { "id": "groups", "action": "actorGroup", "prefix": "bot", "groups": [
      { "name": "ping0", "percent": 25, "proxy": true }, { "name": "ping50", "percent": 25, "proxy": true },
      { "name": "ping100", "percent": 25, "proxy": true }, { "name": "ping200", "rest": true, "proxy": true } ] },
    { "id": "join_all", "action": "connectAll", "prefix": "bot", "timeoutMilliseconds": 60000 },
    { "id": "sessions", "action": "waitFor", "condition": "server.activeSessions", "equals": "${players}", "timeoutMilliseconds": 10000 },
    { "id": "fault0", "action": "groupNetworkFault", "group": "ping0", "latencyMs": "${ping0}", "jitterMs": "${jitterMs}" },
    { "id": "fault50", "action": "groupNetworkFault", "group": "ping50", "latencyMs": "${ping50}", "jitterMs": "${jitterMs}" },
    { "id": "fault100", "action": "groupNetworkFault", "group": "ping100", "latencyMs": "${ping100}", "jitterMs": "${jitterMs}" },
    { "id": "fault200", "action": "groupNetworkFault", "group": "ping200", "latencyMs": "${ping200}", "jitterMs": "${jitterMs}" },
    { "id": "fight0", "action": "groupCombat", "group": "ping0", "center": { "x": -35, "z": -35 }, "radius": 35, "spacing": 8, "pairDistance": 10, "hitPercent": "${hitPercent}", "pauseMs": 1500 },
    { "id": "fight50", "action": "groupCombat", "group": "ping50", "center": { "x": 35, "z": -35 }, "radius": 35, "spacing": 8, "pairDistance": 10, "hitPercent": "${hitPercent}", "pauseMs": 1500 },
    { "id": "fight100", "action": "groupCombat", "group": "ping100", "center": { "x": -35, "z": 35 }, "radius": 35, "spacing": 8, "pairDistance": 10, "hitPercent": "${hitPercent}", "pauseMs": 1500 },
    { "id": "fight200", "action": "groupCombat", "group": "ping200", "center": { "x": 35, "z": 35 }, "radius": 35, "spacing": 8, "pairDistance": 10, "hitPercent": "${hitPercent}", "pauseMs": 1500 },
    { "id": "mark_warmup", "phase": "act", "action": "mark", "text": "warmup_start players=${players}" },
    { "id": "warmup", "action": "measure", "name": "warmup", "seconds": "${warmupSeconds}" },
    { "id": "mark_measure", "action": "mark", "text": "measurement_start" },
    { "id": "steady", "action": "measure", "name": "steady", "seconds": "${steadySeconds}", "saveAs": "steady" },
    { "id": "mark_measure_end", "action": "mark", "text": "measurement_end" },
    { "id": "rtt0", "phase": "assert", "action": "save", "path": "group.ping0.rttMsAvg", "saveAs": "rtt0" },
    { "id": "rtt50", "action": "save", "path": "group.ping50.rttMsAvg", "saveAs": "rtt50" },
    { "id": "rtt100", "action": "save", "path": "group.ping100.rttMsAvg", "saveAs": "rtt100" },
    { "id": "rtt200", "action": "save", "path": "group.ping200.rttMsAvg", "saveAs": "rtt200" },
    { "id": "hits0", "action": "save", "path": "group.ping0.hitsLanded", "saveAs": "hits0" },
    { "id": "hits50", "action": "save", "path": "group.ping50.hitsLanded", "saveAs": "hits50" },
    { "id": "hits100", "action": "save", "path": "group.ping100.hitsLanded", "saveAs": "hits100" },
    { "id": "hits200", "action": "save", "path": "group.ping200.hitsLanded", "saveAs": "hits200" },
    { "id": "presses0", "action": "save", "path": "group.ping0.pressesSent", "saveAs": "presses0" },
    { "id": "presses50", "action": "save", "path": "group.ping50.pressesSent", "saveAs": "presses50" },
    { "id": "presses100", "action": "save", "path": "group.ping100.pressesSent", "saveAs": "presses100" },
    { "id": "presses200", "action": "save", "path": "group.ping200.pressesSent", "saveAs": "presses200" },
    { "id": "running", "assert": "server.running", "equals": true },
    { "id": "all_still_here", "assert": "server.activeSessions", "equals": "${players}" },
    { "id": "players_kept", "assert": "var.steady.playersMin", "equals": "${players}" },
    { "id": "hit_at_0", "assert": "group.ping0.hitsLanded", "greaterThan": 0 },
    { "id": "hit_at_50", "assert": "group.ping50.hitsLanded", "greaterThan": 0 },
    { "id": "hit_at_100", "assert": "group.ping100.hitsLanded", "greaterThan": 0 },
    { "id": "ping_applied", "assert": "group.ping200.rttMsAvg", "greaterThan": "${ping200}" },
    { "id": "no_stall", "assert": "var.steady.stalls", "equals": 0 },
    { "id": "no_tick_failure", "assert": "var.steady.tickFailures", "equals": 0 },
    { "id": "mark_cooldown", "phase": "act", "action": "mark", "text": "cooldown" },
    { "id": "stop", "action": "stopGroup", "group": "all", "saveAs": "groups_end" },
    { "id": "leave", "action": "disconnectAll", "prefix": "bot" },
    { "id": "cooldown", "action": "measure", "name": "cooldown", "seconds": "${cooldownSeconds}" },
    { "id": "all_gone", "phase": "assert", "action": "waitFor", "condition": "server.activeSessions", "equals": 0, "timeoutMilliseconds": 10000 }
  ]
}
