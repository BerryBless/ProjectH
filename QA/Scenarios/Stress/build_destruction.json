{
  "schemaVersion": 1,
  "name": "Stress Build Destruction",
  "description": "Request §27-29: one connected structure of ${pieces} pieces standing on a single foundation, taken down through the real damage path. Arrange (spawnBuildPiece through the existing QA command, spawnBuildPieces layout 'hanging'): a column of south walls on one cell whose bottom wall is the only piece touching the ground, carrying a block of floors and walls that starts two levels above the highest ground under it (the layout checks each piece against the server's grounding rule). Act: one shooter, given a Kestrel LR (90 damage; a wood wall has 150 health) and placed 4 m south of the foundation, fires real shots at the foundation's centre (aim -> fire input -> server hitscan -> piece damage); when it breaks, the server's support search finds the rest without a grounded piece and collapses all of it in that tick (no damageBuild: the real shot reaches the foundation). ${observers} other players (players = observers + 1) walk within 20 m of the structure so the collapse is replicated to them (interest window). The 'collapse' phase samples every second (tick max, send burst KB/s max, GC); it starts with ${pieces} pieces and must end with 0. No hard limit (D42).",
  "tags": ["stress", "server", "building", "quick"],
  "stress": true,
  "seed": 8400,
  "timeoutSeconds": 600,
  "server": { "mode": "launch", "options": { "Server:MaxPlayers": "100", "Server:DevRespawn": "true" } },
  "variables": { "players": 50, "observers": 49, "pieces": 1000, "presses": 8, "beforeSeconds": 5, "collapseSeconds": 10, "cooldownSeconds": 5 },
  "parameters": [ { "pieces": 100 }, { "pieces": 500 }, { "pieces": 1000 } ],
  "actors": [],
  "steps": [
    { "id": "spawn_shooter", "phase": "arrange", "action": "spawnActors", "count": 1, "prefix": "shooter" },
    { "id": "spawn", "action": "spawnActors", "count": "${observers}", "prefix": "bot" },
    { "id": "join_all", "action": "connectAll", "timeoutMilliseconds": 60000 },
    { "id": "sessions", "action": "waitFor", "condition": "server.activeSessions", "equals": "${players}", "timeoutMilliseconds": 10000 },
    { "id": "group_shooter", "action": "actorGroup", "prefix": "shooter", "groups": [ { "name": "shooter", "rest": true } ] },
    { "id": "group_observers", "action": "actorGroup", "prefix": "bot", "groups": [ { "name": "observers", "rest": true } ] },
    { "id": "structure", "action": "spawnBuildPieces", "count": "${pieces}", "layout": "hanging", "center": { "x": 0, "z": 0 }, "saveAs": "hang" },
    { "id": "all_placed", "phase": "assert", "assert": "var.hang.placed", "equals": "${pieces}" },
    { "id": "watch", "phase": "arrange", "action": "groupMove", "group": "observers", "pattern": "random", "center": "${hang.structure.foundation}", "radius": 20 },
    { "id": "mark_before", "phase": "act", "action": "mark", "text": "warmup_start pieces=${pieces} foundation=${hang.structure.pieceId}" },
    { "id": "before", "action": "measure", "name": "before", "seconds": "${beforeSeconds}", "sampleSeconds": 1, "saveAs": "before" },
    { "id": "stand", "phase": "arrange", "action": "setPosition", "actor": "shooter-001", "position": "${hang.structure.shooter}", "yaw": 0 },
    { "id": "rifle", "action": "giveWeapon", "actor": "shooter-001", "weapon": "Kestrel LR", "slot": 0, "select": true },
    { "id": "rounds", "action": "giveAmmo", "actor": "shooter-001", "type": "heavy", "amount": 40 },
    { "id": "armed", "action": "waitFor", "condition": "actor.weaponName", "actor": "shooter-001", "equals": "Kestrel LR", "timeoutMilliseconds": 5000 },
    { "id": "standing", "assert": "build.exists", "pieceId": "${hang.structure.pieceId}", "equals": true },
    { "id": "mark_measure", "phase": "act", "action": "mark", "text": "measurement_start" },
    { "id": "fire", "action": "groupFireAt", "group": "shooter", "at": "${hang.structure.foundation}", "presses": "${presses}", "burst": 1 },
    { "id": "collapse", "action": "measure", "name": "collapse", "seconds": "${collapseSeconds}", "sampleSeconds": 1, "saveAs": "collapse" },
    { "id": "mark_measure_end", "action": "mark", "text": "measurement_end" },
    { "id": "running", "phase": "assert", "assert": "server.running", "equals": true },
    { "id": "foundation_gone", "assert": "build.exists", "pieceId": "${hang.structure.pieceId}", "equals": false },
    { "id": "started_whole", "assert": "var.collapse.buildPiecesStart", "equals": "${pieces}" },
    { "id": "all_collapsed", "assert": "var.collapse.buildPiecesEnd", "equals": 0 },
    { "id": "all_still_here", "assert": "server.activeSessions", "equals": "${players}" },
    { "id": "no_stall", "assert": "var.collapse.stalls", "equals": 0 },
    { "id": "no_tick_failure", "assert": "var.collapse.tickFailures", "equals": 0 },
    { "id": "mark_cooldown", "phase": "act", "action": "mark", "text": "cooldown" },
    { "id": "stop", "action": "stopGroup", "group": "all" },
    { "id": "leave", "action": "disconnectAll" },
    { "id": "cooldown", "action": "measure", "name": "cooldown", "seconds": "${cooldownSeconds}" },
    { "id": "all_gone", "phase": "assert", "action": "waitFor", "condition": "server.activeSessions", "equals": 0, "timeoutMilliseconds": 10000 }
  ]
}
