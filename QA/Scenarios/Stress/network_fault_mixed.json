{
  "schemaVersion": 1,
  "name": "Stress Network Fault Mixed",
  "description": "Request §45-46: a mixed population of network conditions at once, through the actors' own UDP fault proxies (no server protocol change). 60 % plain loopback; 15 % ${lat100} ms latency each way; 10 % ${lat200} ms each way; 10 % ${lossPercent} % loss each way; 5 % combined (${lat100} ms + ${jitterMs} ms jitter + ${lossPercent} % loss). Values follow the latency_sweep convention (latencyMs per direction; the round trip is about twice). The plain group splits into fighters (pairs, real shots) and players switching roles (walk / sprint / loot); every fault group switches roles too. Judged: nobody is disconnected (the loss and delay stay inside LiteNetLib's reliability), fights still land, the server keeps its tick. Saved per group: the connections' average RTT; R1 (input to acknowledgement) covers everyone. DevRespawn. No hard limit (D42).",
  "tags": ["stress", "server", "network", "faults", "quick"],
  "stress": true,
  "seed": 9400,
  "timeoutSeconds": 900,
  "server": { "mode": "launch", "options": { "Server:MaxPlayers": "100", "Server:DevRespawn": "true" } },
  "variables": { "players": 50, "lat100": 100, "lat200": 200, "lossPercent": 5, "jitterMs": 20, "warmupSeconds": 10, "steadySeconds": 60, "cooldownSeconds": 5 },
  "parameters": [ { "players": 50 }, { "players": 100 } ],
  "actors": [],
  "steps": [
    { "id": "spawn", "phase": "arrange", "action": "spawnActors", "count": "${players}", "prefix": "bot" },
    { "id": "groups", "action": "actorGroup", "prefix": "bot", "groups": [
      { "name": "fighters", "percent": 20 }, { "name": "plain", "percent": 40 },
      { "name": "lat100", "percent": 15, "proxy": true }, { "name": "lat200", "percent": 10, "proxy": true },
      { "name": "loss", "percent": 10, "proxy": true }, { "name": "combined", "rest": true, "proxy": true } ] },
    { "id": "join_all", "action": "connectAll", "prefix": "bot", "timeoutMilliseconds": 60000 },
    { "id": "sessions", "action": "waitFor", "condition": "server.activeSessions", "equals": "${players}", "timeoutMilliseconds": 10000 },
    { "id": "fault100", "action": "groupNetworkFault", "group": "lat100", "latencyMs": "${lat100}" },
    { "id": "fault200", "action": "groupNetworkFault", "group": "lat200", "latencyMs": "${lat200}" },
    { "id": "fault_loss", "action": "groupNetworkFault", "group": "loss", "lossPercent": "${lossPercent}" },
    { "id": "fault_combined", "action": "groupNetworkFault", "group": "combined", "latencyMs": "${lat100}", "jitterMs": "${jitterMs}", "lossPercent": "${lossPercent}" },
    { "id": "fight", "action": "groupCombat", "group": "fighters", "pairing": "pairs", "radius": 70 },
    { "id": "roam_plain", "action": "groupRoles", "group": "plain", "roles": [ { "role": "move", "percent": 45 }, { "role": "sprint", "percent": 30 }, { "role": "loot", "percent": 25 } ], "radius": 60 },
    { "id": "roam100", "action": "groupRoles", "group": "lat100", "roles": [ { "role": "move", "percent": 45 }, { "role": "sprint", "percent": 30 }, { "role": "loot", "percent": 25 } ], "radius": 60 },
    { "id": "roam200", "action": "groupRoles", "group": "lat200", "roles": [ { "role": "move", "percent": 45 }, { "role": "sprint", "percent": 30 }, { "role": "loot", "percent": 25 } ], "radius": 60 },
    { "id": "roam_loss", "action": "groupRoles", "group": "loss", "roles": [ { "role": "move", "percent": 45 }, { "role": "sprint", "percent": 30 }, { "role": "loot", "percent": 25 } ], "radius": 60 },
    { "id": "roam_combined", "action": "groupRoles", "group": "combined", "roles": [ { "role": "move", "percent": 45 }, { "role": "sprint", "percent": 30 }, { "role": "loot", "percent": 25 } ], "radius": 60 },
    { "id": "mark_warmup", "phase": "act", "action": "mark", "text": "warmup_start players=${players}" },
    { "id": "warmup", "action": "measure", "name": "warmup", "seconds": "${warmupSeconds}" },
    { "id": "mark_measure", "action": "mark", "text": "measurement_start" },
    { "id": "steady", "action": "measure", "name": "steady", "seconds": "${steadySeconds}", "saveAs": "steady" },
    { "id": "mark_measure_end", "action": "mark", "text": "measurement_end" },
    { "id": "rtt_plain", "phase": "assert", "action": "save", "path": "group.plain.rttMsAvg", "saveAs": "rttPlain" },
    { "id": "rtt100", "action": "save", "path": "group.lat100.rttMsAvg", "saveAs": "rtt100" },
    { "id": "rtt200", "action": "save", "path": "group.lat200.rttMsAvg", "saveAs": "rtt200" },
    { "id": "rtt_loss", "action": "save", "path": "group.loss.rttMsAvg", "saveAs": "rttLoss" },
    { "id": "rtt_combined", "action": "save", "path": "group.combined.rttMsAvg", "saveAs": "rttCombined" },
    { "id": "running", "assert": "server.running", "equals": true },
    { "id": "all_still_here", "assert": "server.activeSessions", "equals": "${players}" },
    { "id": "players_kept", "assert": "var.steady.playersMin", "equals": "${players}" },
    { "id": "shots_landed", "assert": "group.fighters.hitsLanded", "greaterThan": 0 },
    { "id": "ping_applied", "assert": "group.lat200.rttMsAvg", "greaterThan": "${lat200}" },
    { "id": "no_stall", "assert": "var.steady.stalls", "equals": 0 },
    { "id": "no_tick_failure", "assert": "var.steady.tickFailures", "equals": 0 },
    { "id": "mark_cooldown", "phase": "act", "action": "mark", "text": "cooldown" },
    { "id": "stop", "action": "stopGroup", "group": "all" },
    { "id": "leave", "action": "disconnectAll", "prefix": "bot" },
    { "id": "cooldown", "action": "measure", "name": "cooldown", "seconds": "${cooldownSeconds}" },
    { "id": "all_gone", "phase": "assert", "action": "waitFor", "condition": "server.activeSessions", "equals": 0, "timeoutMilliseconds": 10000 }
  ]
}
