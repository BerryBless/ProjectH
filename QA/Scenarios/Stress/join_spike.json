{
  "schemaVersion": 1,
  "name": "Stress Join Spike",
  "description": "Request §34: ${players} players connect at the same moment (groupConnect perSecond 0: every connect command in one pass of the actor pump), then walk. The 'spike' phase samples every second while they come in: tick max, CPU, the first world sync to everyone (send burst), join time per player (connect command to first snapshot: connectMsAvg / Max) and failures (closed, or no snapshot within 15 s; the server's JoinTimeoutSeconds is 5). Failures are counted and asserted, never retried away. DevRespawn. No hard limit (D42).",
  "tags": ["stress", "server", "network", "quick"],
  "stress": true,
  "seed": 8900,
  "timeoutSeconds": 600,
  "server": { "mode": "launch", "options": { "Server:MaxPlayers": "100", "Server:DevRespawn": "true" } },
  "variables": { "players": 100, "spikeSeconds": 10, "steadySeconds": 20, "cooldownSeconds": 5 },
  "parameters": [ { "players": 50 }, { "players": 100 } ],
  "actors": [],
  "steps": [
    { "id": "spawn", "phase": "arrange", "action": "spawnActors", "count": "${players}", "prefix": "bot" },
    { "id": "groups", "action": "actorGroup", "prefix": "bot", "groups": [ { "name": "all", "rest": true } ] },
    { "id": "walk", "action": "groupMove", "group": "all", "pattern": "mixed", "radius": 60 },
    { "id": "empty", "phase": "act", "action": "measure", "name": "empty", "seconds": 3 },
    { "id": "mark_spike", "action": "mark", "text": "warmup_start spike ${players}" },
    { "id": "spike_start", "action": "groupConnect", "group": "all", "perSecond": 0 },
    { "id": "spike", "action": "measure", "name": "spike", "seconds": "${spikeSeconds}", "sampleSeconds": 1, "saveAs": "spike" },
    { "id": "everyone_in", "action": "waitFor", "condition": "server.activeSessions", "equals": "${players}", "timeoutMilliseconds": 30000 },
    { "id": "mark_measure", "action": "mark", "text": "measurement_start" },
    { "id": "steady", "action": "measure", "name": "steady", "seconds": "${steadySeconds}", "saveAs": "steady" },
    { "id": "mark_measure_end", "action": "mark", "text": "measurement_end" },
    { "id": "joins", "phase": "assert", "action": "save", "path": "group.all.stats", "saveAs": "joins" },
    { "id": "running", "assert": "server.running", "equals": true },
    { "id": "all_joined", "assert": "group.all.stats.connects", "equals": "${players}" },
    { "id": "no_join_failure", "assert": "group.all.stats.connectFailures", "equals": 0 },
    { "id": "players_kept", "assert": "var.steady.playersMin", "equals": "${players}" },
    { "id": "no_stall", "assert": "var.spike.stalls", "equals": 0 },
    { "id": "no_tick_failure", "assert": "var.spike.tickFailures", "equals": 0 },
    { "id": "mark_cooldown", "phase": "act", "action": "mark", "text": "cooldown" },
    { "id": "stop", "action": "stopGroup", "group": "all" },
    { "id": "leave", "action": "disconnectAll", "prefix": "bot" },
    { "id": "cooldown", "action": "measure", "name": "cooldown", "seconds": "${cooldownSeconds}" },
    { "id": "all_gone", "phase": "assert", "action": "waitFor", "condition": "server.activeSessions", "equals": 0, "timeoutMilliseconds": 10000 }
  ]
}
