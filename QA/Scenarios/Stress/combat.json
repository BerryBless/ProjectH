{
  "schemaVersion": 1,
  "name": "Stress Combat",
  "description": "Request §14-17, §111: real fights through the whole path (aim -> fire input -> server hitscan -> lag compensation -> damage -> death). Everyone fights in pairs (each shoots its partner, nobody is everyone's target) placed on clear spots of the map (Arrange: setPosition, Vesper AR, ${ammo} ammo, shield). Bursts of ${burst} single presses respecting the weapon's fire interval, ${pauseMs} ms apart, a reload every ${reloadEvery} bursts, strafing. ${hitPercent}% of bursts aim at the chest, the rest above the head (they still go through hitscan and lag compensation, without damage) so deaths stay at a sustainable rate. DevRespawn: the dead respawn after 3 s and the group's re-arm (Arrange, counted in each phase's 'Arrange cmds') gives the weapon back at the pair's spot. damagePlayer is never used. No hard limit (D42).",
  "tags": ["stress", "server", "combat", "quick"],
  "stress": true,
  "seed": 7300,
  "timeoutSeconds": 900,
  "server": { "mode": "launch", "options": { "Server:MaxPlayers": "100", "Server:DevRespawn": "true" } },
  "variables": { "players": 50, "burst": 3, "pauseMs": 2000, "reloadEvery": 5, "hitPercent": 25, "ammo": 300, "warmupSeconds": 10, "steadySeconds": 60, "cooldownSeconds": 10 },
  "parameters": [ { "players": 10 }, { "players": 25 }, { "players": 50 }, { "players": 75 }, { "players": 100 } ],
  "actors": [],
  "steps": [
    { "id": "spawn", "phase": "arrange", "action": "spawnActors", "count": "${players}", "prefix": "bot" },
    { "id": "join_all", "action": "connectAll", "prefix": "bot", "timeoutMilliseconds": 60000 },
    { "id": "sessions", "action": "waitFor", "condition": "server.activeSessions", "equals": "${players}", "timeoutMilliseconds": 10000 },
    { "id": "groups", "action": "actorGroup", "prefix": "bot", "groups": [ { "name": "fighters", "rest": true } ] },
    { "id": "fight", "action": "groupCombat", "group": "fighters", "pairing": "pairs", "weapon": "Vesper AR", "ammo": "${ammo}", "burst": "${burst}", "pauseMs": "${pauseMs}", "reloadEvery": "${reloadEvery}", "hitPercent": "${hitPercent}", "radius": 70, "spacing": 12, "pairDistance": 10, "shield": 100 },
    { "id": "mark_warmup", "phase": "act", "action": "mark", "text": "warmup_start players=${players}" },
    { "id": "warmup", "action": "measure", "name": "warmup", "seconds": "${warmupSeconds}" },
    { "id": "mark_measure", "action": "mark", "text": "measurement_start" },
    { "id": "steady", "action": "measure", "name": "steady", "seconds": "${steadySeconds}", "saveAs": "steady" },
    { "id": "mark_measure_end", "action": "mark", "text": "measurement_end" },
    { "id": "running", "phase": "assert", "assert": "server.running", "equals": true },
    { "id": "all_still_here", "assert": "server.activeSessions", "equals": "${players}" },
    { "id": "players_kept", "assert": "var.steady.playersMin", "equals": "${players}" },
    { "id": "shots_landed", "assert": "group.fighters.hitsLanded", "greaterThan": 0 },
    { "id": "arrange_ok", "assert": "group.fighters.stats.commandFailures", "equals": 0 },
    { "id": "no_stall", "assert": "var.steady.stalls", "equals": 0 },
    { "id": "no_tick_failure", "assert": "var.steady.tickFailures", "equals": 0 },
    { "id": "mark_cooldown", "phase": "act", "action": "mark", "text": "cooldown" },
    { "id": "stop", "action": "stopGroup", "group": "fighters", "saveAs": "fighters" },
    { "id": "leave", "action": "disconnectAll", "prefix": "bot" },
    { "id": "cooldown", "action": "measure", "name": "cooldown", "seconds": "${cooldownSeconds}" },
    { "id": "all_gone", "phase": "assert", "action": "waitFor", "condition": "server.activeSessions", "equals": 0, "timeoutMilliseconds": 10000 }
  ]
}
