{
  "schemaVersion": 1,
  "name": "Stress Turbo Build",
  "description": "Request §23: high-frequency real building inside the normal limits. ${turboPercent} % of the players are turbo builders at ${turboRate} requests/s each (the actor's build path: build mode, two aim ticks, the request after the input that carries the aim = at most 10/s at 30 Hz; the server places one per 0.1 s per player and allows 20 requests/s, so nothing here is over a limit), each on its own flat site (BuildSitePool), recycling the site with real shots at its level-0 pieces (collapses through the support rules) so placing never stops. The rest walk around. Server:BuildInfiniteResources=true: resources cap at 500 (50 wood pieces) and a turbo builder places that in a few seconds; every other placement rule (range, sight, support, occupancy, rate) still applies. The map has about 40 flat sites; at 40 players 30 build. Compare with building.json (1/s builders, 10 % turbo). No hard limit (D42).",
  "tags": ["stress", "server", "building", "quick"],
  "stress": true,
  "seed": 8200,
  "timeoutSeconds": 900,
  "server": { "mode": "launch", "options": { "Server:MaxPlayers": "100", "Server:DevRespawn": "true", "Server:BuildInfiniteResources": "true" } },
  "variables": { "players": 40, "turboPercent": 75, "turboRate": 9, "warmupSeconds": 10, "steadySeconds": 60, "cooldownSeconds": 10 },
  "parameters": [ { "players": 10 }, { "players": 25 }, { "players": 40 } ],
  "actors": [],
  "steps": [
    { "id": "spawn", "phase": "arrange", "action": "spawnActors", "count": "${players}", "prefix": "bot" },
    { "id": "join_all", "action": "connectAll", "prefix": "bot", "timeoutMilliseconds": 60000 },
    { "id": "sessions", "action": "waitFor", "condition": "server.activeSessions", "equals": "${players}", "timeoutMilliseconds": 10000 },
    { "id": "groups", "action": "actorGroup", "prefix": "bot", "groups": [ { "name": "turbo", "percent": "${turboPercent}" }, { "name": "movers", "rest": true } ] },
    { "id": "turbo_build", "action": "groupBuild", "group": "turbo", "ratePerSecond": "${turboRate}", "recycle": true },
    { "id": "move", "action": "groupMove", "group": "movers", "pattern": "random", "radius": 60 },
    { "id": "mark_warmup", "phase": "act", "action": "mark", "text": "warmup_start players=${players}" },
    { "id": "warmup", "action": "measure", "name": "warmup", "seconds": "${warmupSeconds}" },
    { "id": "mark_measure", "action": "mark", "text": "measurement_start" },
    { "id": "steady", "action": "measure", "name": "steady", "seconds": "${steadySeconds}", "saveAs": "steady" },
    { "id": "mark_measure_end", "action": "mark", "text": "measurement_end" },
    { "id": "results", "phase": "assert", "action": "save", "path": "group.turbo.buildResults", "saveAs": "turboResults" },
    { "id": "running", "assert": "server.running", "equals": true },
    { "id": "all_still_here", "assert": "server.activeSessions", "equals": "${players}" },
    { "id": "players_kept", "assert": "var.steady.playersMin", "equals": "${players}" },
    { "id": "turbo_placed", "assert": "group.turbo.buildResults.Ok", "greaterThan": 0 },
    { "id": "within_limits", "assert": "group.turbo.buildResults.RateLimited", "notExists": true },
    { "id": "arrange_ok", "assert": "group.turbo.stats.commandFailures", "equals": 0 },
    { "id": "no_bad_packets", "assert": "var.steady.badPackets", "equals": 0 },
    { "id": "no_stall", "assert": "var.steady.stalls", "equals": 0 },
    { "id": "no_tick_failure", "assert": "var.steady.tickFailures", "equals": 0 },
    { "id": "mark_cooldown", "phase": "act", "action": "mark", "text": "cooldown" },
    { "id": "stop", "action": "stopGroup", "group": "all", "saveAs": "groups_end" },
    { "id": "leave", "action": "disconnectAll", "prefix": "bot" },
    { "id": "cooldown", "action": "measure", "name": "cooldown", "seconds": "${cooldownSeconds}" },
    { "id": "all_gone", "phase": "assert", "action": "waitFor", "condition": "server.activeSessions", "equals": 0, "timeoutMilliseconds": 10000 }
  ]
}
