{
  "schemaVersion": 1,
  "name": "Stress Disconnect Spike",
  "description": "Request §35: every player leaves at the same moment, then all come back. One groupChurn cycle at 100 % (mode ${mode}: graceful = disconnect packets, drop = sockets closed without one, so the server notices after DisconnectTimeoutMs (2000 ms here), mixed = half each), ${offlineMs} ms away, then everyone reconnects with the same DevPlayerId once the server has let go of the old connection. The 'spike' phase samples every second: sessions falling to 0 and back, tick max, memory (no leftover players: the server's player count must come back to exactly ${players}), reconnect time and failures, duplicates. DevRespawn (no grace: a returning player is a new player; the reconnect churn scenario covers grace and resume in a match). No hard limit (D42).",
  "tags": ["stress", "server", "network", "faults", "quick"],
  "stress": true,
  "seed": 9000,
  "timeoutSeconds": 600,
  "server": { "mode": "launch", "options": { "Server:MaxPlayers": "100", "Server:DevRespawn": "true", "Server:DisconnectTimeoutMs": "2000" } },
  "variables": { "players": 50, "mode": "mixed", "offlineMs": 2000, "warmupSeconds": 5, "spikeSeconds": 20, "cooldownSeconds": 5 },
  "parameters": [ { "players": 50 }, { "players": 100 }, { "players": 50, "mode": "drop" }, { "players": 50, "mode": "graceful" } ],
  "actors": [],
  "steps": [
    { "id": "spawn", "phase": "arrange", "action": "spawnActors", "count": "${players}", "prefix": "bot" },
    { "id": "join_all", "action": "connectAll", "prefix": "bot", "timeoutMilliseconds": 60000 },
    { "id": "sessions", "action": "waitFor", "condition": "server.activeSessions", "equals": "${players}", "timeoutMilliseconds": 10000 },
    { "id": "groups", "action": "actorGroup", "prefix": "bot", "groups": [ { "name": "all", "rest": true } ] },
    { "id": "walk", "action": "groupMove", "group": "all", "pattern": "mixed", "radius": 60 },
    { "id": "mark_warmup", "phase": "act", "action": "mark", "text": "warmup_start players=${players}" },
    { "id": "warmup", "action": "measure", "name": "warmup", "seconds": "${warmupSeconds}" },
    { "id": "mark_measure", "action": "mark", "text": "measurement_start ${mode}" },
    { "id": "leave_all", "action": "groupChurn", "group": "all", "percent": 100, "cycles": 1, "cycleSeconds": 1, "mode": "${mode}", "offlineMs": "${offlineMs}" },
    { "id": "spike", "action": "measure", "name": "spike", "seconds": "${spikeSeconds}", "sampleSeconds": 1, "saveAs": "spike" },
    { "id": "mark_measure_end", "action": "mark", "text": "measurement_end" },
    { "id": "churn_end", "action": "stopGroup", "group": "all", "saveAs": "churned" },
    { "id": "running", "phase": "assert", "assert": "server.running", "equals": true },
    { "id": "all_left", "assert": "var.spike.sessionsMin", "lessThan": "${players}" },
    { "id": "all_back", "action": "waitFor", "condition": "server.activeSessions", "equals": "${players}", "timeoutMilliseconds": 15000 },
    { "id": "no_leftover", "assert": "match.playerCount", "equals": "${players}" },
    { "id": "one_cycle", "assert": "var.churned.churnCycles", "equals": 1 },
    { "id": "rejoined", "assert": "var.churned.reconnectFailures", "equals": 0 },
    { "id": "no_duplicates", "assert": "var.churned.duplicates", "equals": 0 },
    { "id": "no_stall", "assert": "var.spike.stalls", "equals": 0 },
    { "id": "no_tick_failure", "assert": "var.spike.tickFailures", "equals": 0 },
    { "id": "mark_cooldown", "phase": "act", "action": "mark", "text": "cooldown" },
    { "id": "leave", "action": "disconnectAll", "prefix": "bot" },
    { "id": "cooldown", "action": "measure", "name": "cooldown", "seconds": "${cooldownSeconds}" },
    { "id": "all_gone", "phase": "assert", "action": "waitFor", "condition": "server.activeSessions", "equals": 0, "timeoutMilliseconds": 10000 }
  ]
}
