{
  "schemaVersion": 1,
  "name": "Stress Loot",
  "description": "Request §30: pickup / drop / pickup / use, all through real input. Every player loots: walks to the nearest item its own client knows of, presses Interact next to it (the server picks the nearest item), presses Drop every ${dropEvery} pickups (the weapon in hand goes back into the world for someone else) and, with a Medkit and health below full or a Shield Cell and shield below full, presses the use button (one press per 4 s, longer than a use takes). The items are the map's loot (DevRespawn refills the spawn points every 30 s) plus everything dropped. The group counts pickups (an item the member went for that went away), Drop presses and use presses (lootPickups, lootDrops, lootUses); a use press at full health or shield is refused by the server and still counts as a press. DevRespawn. No hard limit (D42).",
  "tags": ["stress", "server", "loot", "quick"],
  "stress": true,
  "seed": 8500,
  "timeoutSeconds": 900,
  "server": { "mode": "launch", "options": { "Server:MaxPlayers": "100", "Server:DevRespawn": "true" } },
  "variables": { "players": 50, "dropEvery": 2, "searchRange": 40, "warmupSeconds": 10, "steadySeconds": 60, "cooldownSeconds": 10 },
  "parameters": [ { "players": 25 }, { "players": 50 }, { "players": 100 } ],
  "actors": [],
  "steps": [
    { "id": "spawn", "phase": "arrange", "action": "spawnActors", "count": "${players}", "prefix": "bot" },
    { "id": "join_all", "action": "connectAll", "prefix": "bot", "timeoutMilliseconds": 60000 },
    { "id": "sessions", "action": "waitFor", "condition": "server.activeSessions", "equals": "${players}", "timeoutMilliseconds": 10000 },
    { "id": "groups", "action": "actorGroup", "prefix": "bot", "groups": [ { "name": "looters", "rest": true } ] },
    { "id": "loot", "action": "groupLoot", "group": "looters", "searchRange": "${searchRange}", "dropEvery": "${dropEvery}" },
    { "id": "mark_warmup", "phase": "act", "action": "mark", "text": "warmup_start players=${players}" },
    { "id": "warmup", "action": "measure", "name": "warmup", "seconds": "${warmupSeconds}" },
    { "id": "mark_measure", "action": "mark", "text": "measurement_start" },
    { "id": "steady", "action": "measure", "name": "steady", "seconds": "${steadySeconds}", "saveAs": "steady" },
    { "id": "mark_measure_end", "action": "mark", "text": "measurement_end" },
    { "id": "loot_stats", "phase": "assert", "action": "save", "path": "group.looters.stats", "saveAs": "lootStats" },
    { "id": "running", "assert": "server.running", "equals": true },
    { "id": "all_still_here", "assert": "server.activeSessions", "equals": "${players}" },
    { "id": "picked_up", "assert": "group.looters.stats.lootPickups", "greaterThan": 0 },
    { "id": "dropped", "assert": "group.looters.stats.lootDrops", "greaterThan": 0 },
    { "id": "used", "assert": "group.looters.stats.lootUses", "greaterThan": 0 },
    { "id": "no_stall", "assert": "var.steady.stalls", "equals": 0 },
    { "id": "no_tick_failure", "assert": "var.steady.tickFailures", "equals": 0 },
    { "id": "mark_cooldown", "phase": "act", "action": "mark", "text": "cooldown" },
    { "id": "stop", "action": "stopGroup", "group": "all" },
    { "id": "leave", "action": "disconnectAll", "prefix": "bot" },
    { "id": "cooldown", "action": "measure", "name": "cooldown", "seconds": "${cooldownSeconds}" },
    { "id": "all_gone", "phase": "assert", "action": "waitFor", "condition": "server.activeSessions", "equals": 0, "timeoutMilliseconds": 10000 }
  ]
}
