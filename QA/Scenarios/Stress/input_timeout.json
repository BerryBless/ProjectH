{
  "schemaVersion": 1,
  "name": "Stress Input Timeout",
  "description": "Request §39: several players go silent at once under load. ${normal} players walk; 8 more (idle-001 .. idle-008) stop sending input together (pauseInput: the connection stays up and LiteNetLib keeps pinging). After Server:InputTimeoutSeconds (7 s, the smallest the server allows with the default DisconnectTimeoutMs 5000) the server closes each of them with DisconnectCode.InputTimeout (no grace: they leave at once). The 'timeout' phase samples every second over the closes; the walkers are unaffected (sessions end at ${normal}). DevRespawn. No hard limit (D42).",
  "tags": ["stress", "server", "network", "faults", "quick"],
  "stress": true,
  "seed": 9100,
  "timeoutSeconds": 600,
  "server": { "mode": "launch", "options": { "Server:MaxPlayers": "100", "Server:DevRespawn": "true", "Server:InputTimeoutSeconds": "7" } },
  "variables": { "players": 50, "normal": 42, "warmupSeconds": 5, "timeoutSeconds": 15, "cooldownSeconds": 5 },
  "actors": [],
  "steps": [
    { "id": "spawn", "phase": "arrange", "action": "spawnActors", "count": "${normal}", "prefix": "bot" },
    { "id": "spawn_idle", "action": "spawnActors", "count": 8, "prefix": "idle" },
    { "id": "join_all", "action": "connectAll", "timeoutMilliseconds": 60000 },
    { "id": "sessions", "action": "waitFor", "condition": "server.activeSessions", "equals": "${players}", "timeoutMilliseconds": 10000 },
    { "id": "groups", "action": "actorGroup", "groups": [ { "name": "all", "rest": true } ] },
    { "id": "walk", "action": "groupMove", "group": "all", "pattern": "mixed", "radius": 60 },
    { "id": "mark_warmup", "phase": "act", "action": "mark", "text": "warmup_start players=${players}" },
    { "id": "warmup", "action": "measure", "name": "warmup", "seconds": "${warmupSeconds}" },
    { "id": "mark_measure", "action": "mark", "text": "measurement_start 8 silent" },
    { "id": "silent1", "action": "pauseInput", "actor": "idle-001" },
    { "id": "silent2", "action": "pauseInput", "actor": "idle-002" },
    { "id": "silent3", "action": "pauseInput", "actor": "idle-003" },
    { "id": "silent4", "action": "pauseInput", "actor": "idle-004" },
    { "id": "silent5", "action": "pauseInput", "actor": "idle-005" },
    { "id": "silent6", "action": "pauseInput", "actor": "idle-006" },
    { "id": "silent7", "action": "pauseInput", "actor": "idle-007" },
    { "id": "silent8", "action": "pauseInput", "actor": "idle-008" },
    { "id": "timeout", "action": "measure", "name": "timeout", "seconds": "${timeoutSeconds}", "sampleSeconds": 1, "saveAs": "timeout" },
    { "id": "mark_measure_end", "action": "mark", "text": "measurement_end" },
    { "id": "running", "phase": "assert", "assert": "server.running", "equals": true },
    { "id": "closed1", "assert": "network.disconnectCode", "actor": "idle-001", "equals": "InputTimeout" },
    { "id": "closed2", "assert": "network.disconnectCode", "actor": "idle-002", "equals": "InputTimeout" },
    { "id": "closed3", "assert": "network.disconnectCode", "actor": "idle-003", "equals": "InputTimeout" },
    { "id": "closed4", "assert": "network.disconnectCode", "actor": "idle-004", "equals": "InputTimeout" },
    { "id": "closed5", "assert": "network.disconnectCode", "actor": "idle-005", "equals": "InputTimeout" },
    { "id": "closed6", "assert": "network.disconnectCode", "actor": "idle-006", "equals": "InputTimeout" },
    { "id": "closed7", "assert": "network.disconnectCode", "actor": "idle-007", "equals": "InputTimeout" },
    { "id": "closed8", "assert": "network.disconnectCode", "actor": "idle-008", "equals": "InputTimeout" },
    { "id": "walkers_stay", "assert": "server.activeSessions", "equals": "${normal}" },
    { "id": "no_leftover", "assert": "match.playerCount", "equals": "${normal}" },
    { "id": "no_stall", "assert": "var.timeout.stalls", "equals": 0 },
    { "id": "no_tick_failure", "assert": "var.timeout.tickFailures", "equals": 0 },
    { "id": "mark_cooldown", "phase": "act", "action": "mark", "text": "cooldown" },
    { "id": "stop", "action": "stopGroup", "group": "all" },
    { "id": "leave", "action": "disconnectAll" },
    { "id": "cooldown", "action": "measure", "name": "cooldown", "seconds": "${cooldownSeconds}" },
    { "id": "all_gone", "phase": "assert", "action": "waitFor", "condition": "server.activeSessions", "equals": 0, "timeoutMilliseconds": 10000 }
  ]
}
