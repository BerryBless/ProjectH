{
  "schemaVersion": 1,
  "name": "Stress Build Count",
  "description": "Request §24-26: what many standing pieces cost. Arrange: ${pieces} pieces through the existing QA command only (spawnBuildPiece, one /qa/command per piece, at most 16 in flight; no new backdoor), as columns on the grid nearest the map centre (per level a floor and its south and west walls; each column starts at the terrain under its cell, so every piece is supported). The real cap is the match budget building.json maxBuildPiecesPerMatch = 20,000 (BuildWorld capacity; above it the server answers BudgetFull): the last parameter set asks for 20,010 and checks that exactly 20,000 stand and the budget refused the rest. ${players} players walk around the centre the whole time (movement collides with nearby pieces; pieces inside a player's 100 m interest window are replicated to it), so the phases measure the world with that many pieces, not just memory. Phases: 'empty' before any piece, then (after the spawning, which is outside every measured phase because each QA command also writes a server log line) warmup and steady with the pieces standing. Compare the batch table (Build Count column) across the parameter sets. No hard limit (D42).",
  "tags": ["stress", "server", "building", "slow"],
  "stress": true,
  "seed": 8300,
  "timeoutSeconds": 1200,
  "server": { "mode": "launch", "options": { "Server:MaxPlayers": "100", "Server:DevRespawn": "true" } },
  "variables": { "players": 50, "pieces": 1000, "expectPieces": 1000, "budgetFull": false, "emptySeconds": 10, "warmupSeconds": 5, "steadySeconds": 30, "cooldownSeconds": 5 },
  "parameters": [
    { "pieces": 1000, "expectPieces": 1000 },
    { "pieces": 2500, "expectPieces": 2500 },
    { "pieces": 5000, "expectPieces": 5000 },
    { "pieces": 10000, "expectPieces": 10000 },
    { "pieces": 20010, "expectPieces": 20000, "budgetFull": true }
  ],
  "actors": [],
  "steps": [
    { "id": "spawn", "phase": "arrange", "action": "spawnActors", "count": "${players}", "prefix": "bot" },
    { "id": "join_all", "action": "connectAll", "prefix": "bot", "timeoutMilliseconds": 60000 },
    { "id": "sessions", "action": "waitFor", "condition": "server.activeSessions", "equals": "${players}", "timeoutMilliseconds": 10000 },
    { "id": "groups", "action": "actorGroup", "prefix": "bot", "groups": [ { "name": "walkers", "rest": true } ] },
    { "id": "walk", "action": "groupMove", "group": "walkers", "pattern": "mixed", "radius": 60 },
    { "id": "empty", "phase": "act", "action": "measure", "name": "empty", "seconds": "${emptySeconds}", "saveAs": "empty" },
    { "id": "pieces", "phase": "arrange", "action": "spawnBuildPieces", "count": "${pieces}", "layout": "field", "center": { "x": 0, "z": 0 }, "saveAs": "spawned" },
    { "id": "placed", "phase": "assert", "assert": "var.spawned.placed", "equals": "${expectPieces}" },
    { "id": "server_count", "assert": "var.spawned.serverPieces", "equals": "${expectPieces}" },
    { "id": "budget", "assert": "var.spawned.budgetFull", "equals": "${budgetFull}" },
    { "id": "mark_warmup", "phase": "act", "action": "mark", "text": "warmup_start pieces=${expectPieces}" },
    { "id": "warmup", "action": "measure", "name": "warmup", "seconds": "${warmupSeconds}" },
    { "id": "mark_measure", "action": "mark", "text": "measurement_start" },
    { "id": "steady", "action": "measure", "name": "steady", "seconds": "${steadySeconds}", "saveAs": "steady" },
    { "id": "mark_measure_end", "action": "mark", "text": "measurement_end" },
    { "id": "running", "phase": "assert", "assert": "server.running", "equals": true },
    { "id": "all_still_here", "assert": "server.activeSessions", "equals": "${players}" },
    { "id": "pieces_stand", "assert": "var.steady.buildPiecesEnd", "equals": "${expectPieces}" },
    { "id": "no_stall", "assert": "var.steady.stalls", "equals": 0 },
    { "id": "no_tick_failure", "assert": "var.steady.tickFailures", "equals": 0 },
    { "id": "mark_cooldown", "phase": "act", "action": "mark", "text": "cooldown" },
    { "id": "stop", "action": "stopGroup", "group": "all" },
    { "id": "leave", "action": "disconnectAll", "prefix": "bot" },
    { "id": "cooldown", "action": "measure", "name": "cooldown", "seconds": "${cooldownSeconds}" },
    { "id": "all_gone", "phase": "assert", "action": "waitFor", "condition": "server.activeSessions", "equals": 0, "timeoutMilliseconds": 10000 }
  ]
}
