{
  "schemaVersion": 1,
  "name": "Minimap Shows Where The Player Is",
  "description": "Phase 15 D1, D3 (request §49, §51, §58 minimap_position): a Unity Development player is teleported to two places; the minimap's own icon (the centre of the minimap window), turned back into world metres with the same MapProjection the map draws with, matches the server's position each time (within 0.5 m: 1 cm rounding plus render interpolation). Needs --unity-exe; SKIPPED without it.",
  "tags": ["map", "unity"],
  "seed": 15001,
  "timeoutSeconds": 120,
  "server": { "mode": "launch", "options": { "Server:MinPlayers": "2" } },
  "actors": [
    { "id": "viewer", "type": "UnityClient", "unity": { "width": 1280, "height": 720 } },
    { "id": "other", "type": "HeadlessClient" }
  ],
  "steps": [
    { "id": "viewer_launch", "phase": "arrange", "action": "connect", "actor": "viewer" },
    { "id": "viewer_joined", "action": "waitForUnity", "actor": "viewer", "condition": "joined", "equals": true, "timeoutMilliseconds": 30000 },
    { "id": "other_connect", "action": "connect", "actor": "other" },
    { "id": "match_playing", "action": "waitFor", "condition": "match.state", "equals": "Playing", "timeoutMilliseconds": 15000 },
    { "id": "in_game", "action": "waitForUnity", "actor": "viewer", "condition": "screen", "equals": "InGame", "timeoutMilliseconds": 10000 },

    { "id": "place_a", "action": "setPosition", "actor": "viewer", "position": { "x": 25, "z": -30 } },
    { "id": "settle_a", "action": "wait", "milliseconds": 700 },
    { "id": "save_ax", "action": "save", "actor": "viewer", "path": "player.position.x", "saveAs": "ax" },
    { "id": "save_az", "action": "save", "actor": "viewer", "path": "player.position.z", "saveAs": "az" },
    { "id": "minimap_ax", "phase": "assert", "action": "waitForUnity", "actor": "viewer", "condition": "minimapSelfWorldX", "approximately": "${ax}", "tolerance": 0.5, "timeoutMilliseconds": 3000 },
    { "id": "minimap_az", "action": "waitForUnity", "actor": "viewer", "condition": "minimapSelfWorldZ", "approximately": "${az}", "tolerance": 0.5, "timeoutMilliseconds": 3000 },
    { "id": "shot_a", "phase": "act", "action": "captureScreenshot", "actor": "viewer", "name": "minimap_at_25_-30" },

    { "id": "place_b", "action": "setPosition", "actor": "viewer", "position": { "x": -40, "z": 50 } },
    { "id": "settle_b", "action": "wait", "milliseconds": 700 },
    { "id": "save_bx", "action": "save", "actor": "viewer", "path": "player.position.x", "saveAs": "bx" },
    { "id": "save_bz", "action": "save", "actor": "viewer", "path": "player.position.z", "saveAs": "bz" },
    { "id": "minimap_bx", "phase": "assert", "action": "waitForUnity", "actor": "viewer", "condition": "minimapSelfWorldX", "approximately": "${bx}", "tolerance": 0.5, "timeoutMilliseconds": 3000 },
    { "id": "minimap_bz", "action": "waitForUnity", "actor": "viewer", "condition": "minimapSelfWorldZ", "approximately": "${bz}", "tolerance": 0.5, "timeoutMilliseconds": 3000 },
    { "id": "shot_b", "phase": "act", "action": "captureScreenshot", "actor": "viewer", "name": "minimap_at_-40_50" }
  ]
}
