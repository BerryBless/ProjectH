{
  "schemaVersion": 1,
  "name": "Rocket",
  "description": "Phase 17 D10, D6, D7 (request §75, §76): A fires a Thunder RL rocket (40 m/s, magazine 1) at a wood wall 10 m east. B hears ProjectileSpawned, the rocket flies about a quarter second, explodes at the wall and its 300 structure damage destroys the wall (BuildDestroyed). The magazine of A is empty after the one round.",
  "tags": ["weapons", "projectile", "building"],
  "seed": 17006,
  "timeoutSeconds": 60,
  "server": { "mode": "launch", "options": { "Server:MinPlayers": "2" } },
  "actors": [ { "id": "playerA" }, { "id": "playerB" } ],
  "steps": [
    { "id": "a_connect", "action": "connect", "actor": "playerA" },
    { "id": "b_connect", "action": "connect", "actor": "playerB" },
    { "id": "match_playing", "action": "waitFor", "condition": "match.playing", "equals": true, "timeoutMilliseconds": 20000 },

    { "id": "wall", "phase": "arrange", "action": "spawnBuildPiece", "piece": "wall", "material": "wood", "cellX": 16, "level": 0, "cellZ": 16, "rotation": 1, "saveAs": "wall" },
    { "id": "wall_up", "action": "waitFor", "condition": "build.exists", "pieceId": "${wall.pieceId}", "equals": true, "timeoutMilliseconds": 2000 },
    { "id": "a_place", "action": "setPosition", "actor": "playerA", "position": { "x": -10, "z": 2.5, "yaw": 90 } },
    { "id": "b_place", "action": "setPosition", "actor": "playerB", "position": { "x": -10, "z": -15, "yaw": 0 } },
    { "id": "a_rocket", "action": "giveWeapon", "actor": "playerA", "weapon": "Thunder RL", "rarity": 0, "select": true },
    { "id": "a_armed", "action": "waitFor", "condition": "player.weapon.name", "actor": "playerA", "equals": "Thunder RL", "timeoutMilliseconds": 3000 },
    { "id": "a_aim", "action": "aim", "actor": "playerA", "at": { "x": 0, "y": 1.5, "z": 2.5 } },
    { "id": "settle", "action": "wait", "milliseconds": 500 },

    { "id": "a_fire", "phase": "act", "action": "fire", "actor": "playerA", "count": 1 },

    { "id": "b_saw_launch", "phase": "assert", "action": "waitFor", "condition": "actor.projectilesSpawned", "actor": "playerB", "greaterThan": 0, "timeoutMilliseconds": 2000 },
    { "id": "destroyed", "action": "waitForEvent", "event": "BuildDestroyed", "timeoutMilliseconds": 3000, "description": "the server logs the destroy before the explosion of the same tick" },
    { "id": "boom", "action": "waitForEvent", "event": "Explosion", "where": { "kind": "Rocket" }, "timeoutMilliseconds": 3000 },
    { "id": "b_saw_boom", "action": "waitFor", "condition": "actor.projectilesExploded", "actor": "playerB", "greaterThan": 0, "timeoutMilliseconds": 2000 },
    { "id": "wall_gone", "assert": "build.exists", "pieceId": "${wall.pieceId}", "equals": false },
    { "id": "mag_empty", "assert": "player.weapon.magAmmo", "actor": "playerA", "equals": 0 },
    { "id": "a_untouched", "assert": "player.health", "actor": "playerA", "equals": 100, "description": "no self damage, and 10 m away anyway" }
  ]
}
