{
  "schemaVersion": 1,
  "name": "Loot Container Visuals On A Unity Client (Screenshots)",
  "description": "Phase 16 D8 (request §59, §63, §64): a Unity Development player sees a closed chest (container 15) and a closed ammo box (container 20), an opened chest (17), then stands at chest 15 (the [E] prompt says chest), really presses E and the chest opens with its loot on the ground; a supply drop falls (parachute) and lands (light beam) and the minimap draws it. Needs --unity-exe; SKIPPED without it.",
  "tags": ["loot", "unity", "slow"],
  "seed": 16101,
  "timeoutSeconds": 240,
  "server": { "mode": "launch", "options": { "Server:MinPlayers": "2" } },
  "actors": [
    { "id": "viewer", "type": "UnityClient", "unity": { "width": 1600, "height": 900 } },
    { "id": "other", "type": "HeadlessClient" }
  ],
  "steps": [
    { "id": "viewer_launch", "phase": "arrange", "action": "connect", "actor": "viewer" },
    { "id": "viewer_joined", "action": "waitForUnity", "actor": "viewer", "condition": "joined", "equals": true, "timeoutMilliseconds": 30000 },
    { "id": "other_connect", "action": "connect", "actor": "other" },
    { "id": "match_playing", "action": "waitFor", "condition": "match.playing", "equals": true, "timeoutMilliseconds": 20000 },
    { "id": "in_game", "action": "waitForUnity", "actor": "viewer", "condition": "screen", "equals": "InGame", "timeoutMilliseconds": 10000 },
    { "id": "other_away", "action": "setPosition", "actor": "other", "position": { "x": 60, "z": 60 } },

    { "id": "chest_closed", "action": "setContainer", "container": 15, "state": "closed" },
    { "id": "ammo_closed", "action": "setContainer", "container": 20, "state": "closed" },
    { "id": "chest_open_other", "action": "setContainer", "container": 17, "state": "open" },
    { "id": "viewer_overview", "action": "setPosition", "actor": "viewer", "position": { "x": -4, "z": -32, "yaw": 0 } },
    { "id": "overview_settle", "action": "wait", "milliseconds": 900 },
    { "id": "shot_containers", "phase": "act", "action": "captureScreenshot", "actor": "viewer", "name": "closed_chest_left_ammo_box_right" },

    { "id": "viewer_at_chest", "action": "setPosition", "actor": "viewer", "position": { "x": -16, "z": -22.2 } },
    { "id": "chest_settle", "action": "wait", "milliseconds": 700 },
    { "id": "prompt_chest", "phase": "assert", "action": "waitForUnity", "actor": "viewer", "condition": "lootPrompt", "equals": "chest", "timeoutMilliseconds": 3000 },
    { "id": "shot_prompt", "phase": "act", "action": "captureScreenshot", "actor": "viewer", "name": "chest_prompt" },
    { "id": "press_e", "action": "unityKey", "actor": "viewer", "key": "e", "description": "Really press E: the server opens the chest" },
    { "id": "chest_opened", "phase": "assert", "action": "waitFor", "condition": "loot.containers.15.state", "equals": "open", "timeoutMilliseconds": 3000 },
    { "id": "chest_items", "assert": "loot.items.count", "at": { "x": -16, "z": -20 }, "radius": 2, "greaterThan": 0 },
    { "id": "open_settle", "phase": "act", "action": "wait", "milliseconds": 600 },
    { "id": "shot_opened", "action": "captureScreenshot", "actor": "viewer", "name": "chest_opened_with_loot" },

    { "id": "viewer_watch_drop", "action": "setPosition", "actor": "viewer", "position": { "x": 3, "z": -12 }, "description": "38 m south of the drop: it stays inside the camera's upward limit (about 30 degrees)" },
    { "id": "drop_spawn", "action": "spawnSupplyDrop", "position": { "x": 6, "z": 26 }, "saveAs": "drop" },
    { "id": "drop_falling_settle", "action": "wait", "milliseconds": 9000, "description": "About 24 m above the ground after 9 of its 15 s" },
    { "id": "minimap_drop", "phase": "assert", "action": "waitForUnity", "actor": "viewer", "condition": "mapSupplyDrops", "equals": 1, "timeoutMilliseconds": 3000 },
    { "id": "look_up", "phase": "act", "action": "unityLook", "actor": "viewer", "dy": 250, "ms": 200, "description": "Look up about 25 degrees at the falling drop" },
    { "id": "look_up_settle", "action": "wait", "milliseconds": 300 },
    { "id": "shot_falling", "action": "captureScreenshot", "actor": "viewer", "name": "supply_drop_falling" },
    { "id": "look_level", "action": "unityLook", "actor": "viewer", "dy": -250, "ms": 200 },
    { "id": "drop_landed", "phase": "assert", "action": "waitFor", "condition": "loot.supplyDrops.0.state", "equals": "Landed", "timeoutMilliseconds": 18000 },
    { "id": "land_settle", "phase": "act", "action": "wait", "milliseconds": 600 },
    { "id": "shot_landed", "action": "captureScreenshot", "actor": "viewer", "name": "supply_drop_landed" }
  ]
}
