{
  "schemaVersion": 1,
  "name": "Building Edit Visuals On A Unity Client (Screenshots)",
  "description": "Phase 13.5: a Unity Development player looks at edited pieces placed and edited through QA commands (spawnBuildPiece, editBuild) and the report gets screenshots: south walls (rotation 0) and west walls (rotation 1) with a window, a door, a half wall and a large opening (the two rotations must draw the same opening on their own edge: the review's mesh-cache bug drew a west wall along X), floors with a quarter, a half and a diagonal opened, roofs as a one-way slope, a passage and a flat roof, and a ramp turned by an edit. Needs --unity-exe; SKIPPED without it.",
  "tags": ["building", "unity", "slow"],
  "seed": 1304,
  "timeoutSeconds": 240,
  "server": { "mode": "launch", "options": { "Server:MinPlayers": "2" } },
  "actors": [
    { "id": "builder", "type": "HeadlessClient" },
    { "id": "viewer", "type": "UnityClient", "unity": { "width": 1600, "height": 900 } }
  ],
  "steps": [
    { "id": "builder_connect", "phase": "arrange", "action": "connect", "actor": "builder" },
    { "id": "viewer_launch", "action": "connect", "actor": "viewer" },
    { "id": "viewer_joined", "action": "waitForUnity", "actor": "viewer", "condition": "joined", "equals": true, "timeoutMilliseconds": 30000 },
    { "id": "match_playing", "action": "waitFor", "condition": "match.state", "equals": "Playing", "timeoutMilliseconds": 15000 },
    { "id": "in_game", "action": "waitForUnity", "actor": "viewer", "condition": "screen", "equals": "InGame", "timeoutMilliseconds": 10000 },
    { "id": "builder_away", "action": "setPosition", "actor": "builder", "position": { "x": -60, "z": -60, "yaw": 0 } },

    { "id": "s_window", "action": "spawnBuildPiece", "piece": "wall", "material": "wood", "cellX": 15, "level": 0, "cellZ": 13, "rotation": 0, "saveAs": "sWindow" },
    { "id": "s_door", "action": "spawnBuildPiece", "piece": "wall", "material": "stone", "cellX": 16, "level": 0, "cellZ": 13, "rotation": 0, "saveAs": "sDoor" },
    { "id": "s_half", "action": "spawnBuildPiece", "piece": "wall", "material": "metal", "cellX": 17, "level": 0, "cellZ": 13, "rotation": 0, "saveAs": "sHalf" },
    { "id": "s_open", "action": "spawnBuildPiece", "piece": "wall", "material": "wood", "cellX": 18, "level": 0, "cellZ": 13, "rotation": 0, "saveAs": "sOpen" },
    { "id": "w_window", "action": "spawnBuildPiece", "piece": "wall", "material": "wood", "cellX": 21, "level": 0, "cellZ": 8, "rotation": 1, "saveAs": "wWindow" },
    { "id": "w_door", "action": "spawnBuildPiece", "piece": "wall", "material": "stone", "cellX": 21, "level": 0, "cellZ": 9, "rotation": 1, "saveAs": "wDoor" },
    { "id": "w_half", "action": "spawnBuildPiece", "piece": "wall", "material": "metal", "cellX": 21, "level": 0, "cellZ": 10, "rotation": 1, "saveAs": "wHalf" },

    { "id": "c_wall1", "action": "spawnBuildPiece", "piece": "wall", "material": "stone", "cellX": 23, "level": 0, "cellZ": 13, "rotation": 0 },
    { "id": "c_wall2", "action": "spawnBuildPiece", "piece": "wall", "material": "stone", "cellX": 24, "level": 0, "cellZ": 13, "rotation": 0 },
    { "id": "c_wall3", "action": "spawnBuildPiece", "piece": "wall", "material": "stone", "cellX": 25, "level": 0, "cellZ": 13, "rotation": 0 },
    { "id": "f_quarter", "action": "spawnBuildPiece", "piece": "floor", "material": "wood", "cellX": 23, "level": 1, "cellZ": 12, "saveAs": "fQuarter" },
    { "id": "f_half", "action": "spawnBuildPiece", "piece": "floor", "material": "wood", "cellX": 24, "level": 1, "cellZ": 12, "saveAs": "fHalf" },
    { "id": "f_diag", "action": "spawnBuildPiece", "piece": "floor", "material": "wood", "cellX": 25, "level": 1, "cellZ": 12, "saveAs": "fDiag" },
    { "id": "r_slope", "action": "spawnBuildPiece", "piece": "roof", "material": "metal", "cellX": 23, "level": 0, "cellZ": 13, "saveAs": "rSlope" },
    { "id": "r_pass", "action": "spawnBuildPiece", "piece": "roof", "material": "metal", "cellX": 24, "level": 0, "cellZ": 13, "saveAs": "rPass" },
    { "id": "r_flat", "action": "spawnBuildPiece", "piece": "roof", "material": "metal", "cellX": 25, "level": 0, "cellZ": 13, "saveAs": "rFlat" },
    { "id": "ramp", "action": "spawnBuildPiece", "piece": "ramp", "material": "wood", "cellX": 26, "level": 0, "cellZ": 12, "rotation": 0, "saveAs": "ramp" },

    { "id": "e_s_window", "phase": "act", "action": "editBuild", "pieceId": "${sWindow.pieceId}", "edit": 16, "description": "Window: centre tile" },
    { "id": "e_s_door", "action": "editBuild", "pieceId": "${sDoor.pieceId}", "edit": 18, "description": "Door: middle column, bottom two tiles" },
    { "id": "e_s_half", "action": "editBuild", "pieceId": "${sHalf.pieceId}", "edit": 448, "description": "Half wall: top row" },
    { "id": "e_s_open", "action": "editBuild", "pieceId": "${sOpen.pieceId}", "edit": 146, "description": "Large opening: whole middle column" },
    { "id": "e_w_window", "action": "editBuild", "pieceId": "${wWindow.pieceId}", "edit": 16 },
    { "id": "e_w_door", "action": "editBuild", "pieceId": "${wDoor.pieceId}", "edit": 18 },
    { "id": "e_w_half", "action": "editBuild", "pieceId": "${wHalf.pieceId}", "edit": 448 },
    { "id": "e_f_quarter", "action": "editBuild", "pieceId": "${fQuarter.pieceId}", "edit": 1, "description": "One quarter opened" },
    { "id": "e_f_half", "action": "editBuild", "pieceId": "${fHalf.pieceId}", "edit": 3, "description": "Half opened" },
    { "id": "e_f_diag", "action": "editBuild", "pieceId": "${fDiag.pieceId}", "edit": 6, "description": "Diagonal quarters opened" },
    { "id": "e_r_slope", "action": "editBuild", "pieceId": "${rSlope.pieceId}", "edit": 1, "description": "One-way slope rising to +Z" },
    { "id": "e_r_pass", "action": "editBuild", "pieceId": "${rPass.pieceId}", "edit": 6, "description": "Passage" },
    { "id": "e_r_flat", "action": "editBuild", "pieceId": "${rFlat.pieceId}", "edit": 5, "description": "Flat roof" },
    { "id": "e_ramp", "action": "editBuild", "pieceId": "${ramp.pieceId}", "edit": 0, "rotation": 1, "description": "Ramp turned to rise towards +X" },
    { "id": "built_settle", "action": "wait", "milliseconds": 5500, "description": "Metal finishes construction in 5 s" },

    { "id": "view_south", "phase": "act", "action": "setPosition", "actor": "viewer", "position": { "x": 7.5, "z": -27, "yaw": 0 } },
    { "id": "view_south_settle", "action": "wait", "milliseconds": 700 },
    { "id": "shot_south", "action": "captureScreenshot", "actor": "viewer", "name": "south_walls_window_door_half_opening" },
    { "id": "view_west", "action": "setPosition", "actor": "viewer", "position": { "x": 15, "z": -32.5, "yaw": 90 } },
    { "id": "turn_east", "action": "unityLook", "actor": "viewer", "dx": 900, "ms": 300, "description": "The player keeps its own camera yaw after a teleport: turn 90 degrees right (0.1 degree per pixel) to face +X" },
    { "id": "view_west_settle", "action": "wait", "milliseconds": 700 },
    { "id": "shot_west", "action": "captureScreenshot", "actor": "viewer", "name": "west_walls_window_door_half" },
    { "id": "view_top", "action": "setPosition", "actor": "viewer", "position": { "x": 42.5, "y": 12, "z": -27, "yaw": 0 }, "description": "High above, falling: look down on the floors and roofs" },
    { "id": "turn_north_down", "action": "unityLook", "actor": "viewer", "dx": -900, "dy": -450, "ms": 200, "description": "Back to +Z and look down about 45 degrees" },
    { "id": "view_top_settle", "action": "wait", "milliseconds": 100 },
    { "id": "shot_top", "action": "captureScreenshot", "actor": "viewer", "name": "floors_roofs_ramp" }
  ]
}
