{
  "schemaVersion": 1,
  "name": "Build With Real Unity Input",
  "description": "Roadmap 2026-10-05 STEP 2 §10 through the real input path (§87): a Unity Development player is driven with virtual keyboard and mouse input (unityKey / unityClick / unityLook). It walks (W), enters build mode (Q), picks a wall (Z), sees a valid preview, places it with a click, sees the slot turn invalid, is stopped by its own wall, harvests a tree (F), turbo-builds with the button held while turning and goes back to the weapon (1). Phase 13.5: it also edits the wall (H, click a tile, H) and resets it (H, right click). The server decides every result; screenshots show the previews. Needs --unity-exe; SKIPPED without it.",
  "tags": ["building", "unity", "input", "slow"],
  "seed": 1303,
  "timeoutSeconds": 240,
  "server": {"mode": "launch", "options": {"Server:MinPlayers": "2"}},
  "actors": [
    {"id": "buddy", "type": "HeadlessClient"},
    {"id": "viewer", "type": "UnityClient", "unity": {"width": 1280, "height": 720}}
  ],
  "steps": [
    {"id": "buddy_connect", "phase": "arrange", "action": "connect", "actor": "buddy"},
    {"id": "viewer_launch", "action": "connect", "actor": "viewer"},
    {"id": "viewer_joined", "action": "waitForUnity", "actor": "viewer", "condition": "joined", "equals": true, "timeoutMilliseconds": 30000},
    {"id": "match_playing", "action": "waitFor", "condition": "match.state", "equals": "Playing", "timeoutMilliseconds": 15000},
    {"id": "in_game", "action": "waitForUnity", "actor": "viewer", "condition": "screen", "equals": "InGame", "timeoutMilliseconds": 10000},
    {"id": "cursor", "action": "waitForUnity", "actor": "viewer", "condition": "cursorLocked", "equals": true, "timeoutMilliseconds": 3000},
    {"id": "viewer_place", "action": "setPosition", "actor": "viewer", "position": {"x": 12.5, "z": -22.5, "yaw": 0}, "description": "Centre of build cell (18, 11), facing +Z (north)"},
    {"id": "viewer_wood", "action": "giveResource", "actor": "viewer", "material": "wood", "amount": 200},
    {"id": "viewer_has_wood", "action": "waitFor", "condition": "player.resources.wood", "actor": "viewer", "equals": 200, "timeoutMilliseconds": 3000},
    {"id": "z_start", "action": "save", "path": "player.position.z", "actor": "viewer", "saveAs": "z0"},
    {"id": "walk", "phase": "act", "action": "unityKey", "actor": "viewer", "key": "w", "holdMs": 600, "description": "Hold W: about 3 m north, into cell (18, 12)"},
    {"id": "walked", "phase": "assert", "action": "waitFor", "condition": "player.position.z", "actor": "viewer", "greaterThan": "${z0}", "timeoutMilliseconds": 2000},
    {"id": "settle_walk", "phase": "arrange", "action": "setPosition", "actor": "viewer", "position": {"x": 12.5, "z": -17.5, "yaw": 0}, "description": "Back to an exact spot: centre of cell (18, 12), the wall slot ahead is its north edge (z = -15)"},
    {"id": "build_mode", "phase": "act", "action": "unityKey", "actor": "viewer", "key": "q"},
    {"id": "tool_build", "phase": "assert", "action": "waitForUnity", "actor": "viewer", "condition": "tool", "equals": "Build", "timeoutMilliseconds": 3000},
    {"id": "server_tool_build", "action": "waitFor", "condition": "player.tool", "actor": "viewer", "equals": "Build", "timeoutMilliseconds": 3000},
    {"id": "pick_wall", "phase": "act", "action": "unityKey", "actor": "viewer", "key": "z"},
    {"id": "preview_valid", "phase": "assert", "action": "waitForUnity", "actor": "viewer", "condition": "preview", "equals": "Valid", "timeoutMilliseconds": 3000},
    {"id": "shot_preview_valid", "phase": "act", "action": "captureScreenshot", "actor": "viewer", "name": "preview_valid"},
    {"id": "place", "action": "unityClick", "actor": "viewer"},
    {"id": "wall_placed", "phase": "assert", "action": "waitFor", "condition": "build.count", "at": "QA_Build_Test", "radius": 10, "equals": 1, "timeoutMilliseconds": 3000},
    {"id": "wood_paid", "action": "waitFor", "condition": "player.resources.wood", "actor": "viewer", "lessThan": 200, "timeoutMilliseconds": 3000},
    {"id": "wall_id", "action": "save", "path": "build.pieces.0.id", "at": "QA_Build_Test", "radius": 10, "saveAs": "wallId"},
    {"id": "preview_taken", "action": "waitForUnity", "actor": "viewer", "condition": "preview", "equals": "Invalid", "timeoutMilliseconds": 3000, "description": "The same slot is now taken: the preview turns invalid"},
    {"id": "construction", "phase": "act", "action": "wait", "milliseconds": 1700},
    {"id": "shot_preview_invalid", "action": "captureScreenshot", "actor": "viewer", "name": "preview_invalid"},
    {"id": "walk_into_wall", "action": "unityKey", "actor": "viewer", "key": "w", "holdMs": 1200, "description": "Walk north into the wall"},
    {"id": "blocked", "phase": "assert", "action": "assert", "path": "player.position.z", "actor": "viewer", "lessThan": -15, "description": "Still south of the wall plane"},
    {"id": "edit_spot", "phase": "arrange", "action": "setPosition", "actor": "viewer", "position": {"x": 12.5, "z": -17.5, "yaw": 0}, "description": "Phase 13.5: 2.5 m from the wall, looking straight at its middle"},
    {"id": "edit_spot_settle", "action": "wait", "milliseconds": 500, "description": "Let the teleport reach the player"},
    {"id": "edit_start", "phase": "act", "action": "unityKey", "actor": "viewer", "key": "h", "description": "H: edit the wall in the aim"},
    {"id": "edit_pick", "action": "unityClick", "actor": "viewer", "description": "Click the tile in the aim (a window at eye level)"},
    {"id": "shot_edit_select", "action": "captureScreenshot", "actor": "viewer", "name": "edit_select"},
    {"id": "edit_confirm", "action": "unityKey", "actor": "viewer", "key": "h", "description": "H again: confirm (BuildEditRequest)"},
    {"id": "edited", "phase": "assert", "action": "waitFor", "condition": "build.piece.edit", "pieceId": "${wallId}", "greaterThan": 0, "timeoutMilliseconds": 3000},
    {"id": "shot_edited", "phase": "act", "action": "captureScreenshot", "actor": "viewer", "name": "edited"},
    {"id": "edit_solid_spot", "phase": "arrange", "action": "setPosition", "actor": "viewer", "position": {"x": 10.8, "z": -17.5, "yaw": 0}, "description": "In front of the wall's west column (x 10-11.67), still solid: the aim ray must hit the piece to start editing"},
    {"id": "edit_settle", "action": "wait", "milliseconds": 500, "description": "Let the teleport reach the player (the camera must aim at the solid column, not the window)"},
    {"id": "edit_again", "phase": "act", "action": "unityKey", "actor": "viewer", "key": "h"},
    {"id": "shot_edit_reset_mode", "action": "captureScreenshot", "actor": "viewer", "name": "edit_reset_mode"},
    {"id": "edit_reset", "action": "unityClick", "actor": "viewer", "button": "right", "description": "Right click in edit mode: Reset"},
    {"id": "reset", "phase": "assert", "action": "waitFor", "condition": "build.piece.edit", "pieceId": "${wallId}", "equals": 0, "timeoutMilliseconds": 3000},
    {"id": "to_tree", "phase": "arrange", "action": "setPosition", "actor": "viewer", "position": {"x": 40, "z": 27.5, "yaw": 0}, "description": "2.5 m south of the tree at (40, 30), facing it (before any mouse look, the camera still faces the set yaw)"},
    {"id": "harvest_tool", "phase": "act", "action": "unityKey", "actor": "viewer", "key": "f"},
    {"id": "tool_harvest", "phase": "assert", "action": "waitForUnity", "actor": "viewer", "condition": "tool", "equals": "Harvest", "timeoutMilliseconds": 3000},
    {"id": "wood_before", "action": "save", "path": "player.resources.wood", "actor": "viewer", "saveAs": "woodBefore"},
    {"id": "swing", "phase": "act", "action": "unityClick", "actor": "viewer", "holdMs": 1500, "description": "Hold to swing at the tree"},
    {"id": "harvested", "phase": "assert", "action": "waitFor", "condition": "player.resources.wood", "actor": "viewer", "greaterThan": "${woodBefore}", "timeoutMilliseconds": 3000},
    {"id": "shot_harvest", "phase": "act", "action": "captureScreenshot", "actor": "viewer", "name": "harvest"},
    {"id": "back_to_wall", "phase": "arrange", "action": "setPosition", "actor": "viewer", "position": {"x": 12.5, "z": -17.5, "yaw": 0}, "description": "Back inside cell (18, 12)"},
    {"id": "build_again", "phase": "act", "action": "unityKey", "actor": "viewer", "key": "q"},
    {"id": "tool_build_again", "phase": "assert", "action": "waitForUnity", "actor": "viewer", "condition": "tool", "equals": "Build", "timeoutMilliseconds": 3000},
    {"id": "turbo_hold", "phase": "act", "action": "unityClick", "actor": "viewer", "holdMs": 1800, "async": true, "description": "Hold the button (turbo build)"},
    {"id": "turbo_turn", "action": "unityLook", "actor": "viewer", "dx": 2500, "ms": 1500, "description": "Turn right while holding: the wall slot moves round the cell"},
    {"id": "turbo_built", "phase": "assert", "action": "waitFor", "condition": "build.count", "at": "QA_Build_Test", "radius": 10, "greaterThan": 1, "timeoutMilliseconds": 3000},
    {"id": "shot_turbo", "phase": "act", "action": "captureScreenshot", "actor": "viewer", "name": "turbo"},
    {"id": "weapon", "action": "unityKey", "actor": "viewer", "key": "1"},
    {"id": "tool_weapon", "phase": "assert", "action": "waitForUnity", "actor": "viewer", "condition": "tool", "equals": "Weapon", "timeoutMilliseconds": 3000}
  ]
}
